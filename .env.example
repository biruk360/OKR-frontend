# Copy to .env on the server (OKR-frontend/.env). Never commit .env.

# Database (dev uses SQLite; production can keep SQLite with a persistent path or switch to Postgres)
# Relative to the prisma/ directory (where schema.prisma lives)
DATABASE_URL="file:./dev.db"

# Auth — required in production (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# Optional branding
# NEXT_PUBLIC_APP_NAME=
# NEXT_PUBLIC_BASE_PATH=

# Pusher (realtime) — required if you use live features
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Email (SendGrid) — optional
# SENDGRID_API_KEY=
# FROM_EMAIL=

# Client error reporting (default on; set to "false" to disable)
# NEXT_PUBLIC_CLIENT_ERROR_REPORTING=

# Project creation private upload storage and required ClamAV daemon
# Keep PROJECT_CREATION_UPLOAD_DIR outside this app's public/ directory.
# PROJECT_CREATION_UPLOAD_DIR=/var/lib/okr/project-creation-uploads
PROJECT_CREATION_CLAMAV_HOST=127.0.0.1
# PROJECT_CREATION_CLAMAV_PORT=3310
# PROJECT_CREATION_CLAMAV_TIMEOUT_MS=10000
# Optional archive-safety overrides (defaults: 10000 entries, 50 MB/entry,
# 100 MB expanded total, 100:1 maximum compression ratio).
# PROJECT_CREATION_UPLOAD_MAX_ARCHIVE_ENTRIES=10000
# PROJECT_CREATION_UPLOAD_MAX_ARCHIVE_ENTRY_BYTES=52428800
# PROJECT_CREATION_UPLOAD_MAX_UNCOMPRESSED_BYTES=104857600
# PROJECT_CREATION_UPLOAD_MAX_COMPRESSION_RATIO=100
# Ordered DOCX extraction bounds (defaults shown; pages use saved metadata plus explicit page breaks).
# PROJECT_CREATION_DOCX_MAX_BLOCKS=10000
# PROJECT_CREATION_DOCX_MAX_CHARACTERS=500000
# PROJECT_CREATION_DOCX_MAX_PAGES=200
