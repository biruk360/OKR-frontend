# dependencies
node_modules
/.pnp
.pnp.js

# Next.js build output, including every NEXT_DIST_DIR variant
# (.next.build / .next.prev used by scripts/deploy.sh, and any ad-hoc
# verification dir) — a new one should never need a new gitignore line.
.next*/
out/

# env / secrets (use env.example only in repo)
.env
.env*.local

# local SQLite (use seeds / migrations)
*.db
*.db-journal
# Backup snapshots created by manual migrations — never commit
dev.db.backup-*
dev.db.pre-*
prisma/dev.db.backup-*
prisma/dev.db.pre-*
prisma/shadow.db*

# Throwaway diagnostic / migration helper scripts
prisma/diag-*.ts
prisma/inspect-tables.ts

# debug / OS
npm-debug.log*
.DS_Store

# Vercel
.vercel

# TypeScript build info
*.tsbuildinfo

# IDE
.idea/
.vscode/

# User-uploaded comment attachments — never committed.
/var/uploads/
# Legacy upload location (pre-authenticated-serve).
/public/uploads/
