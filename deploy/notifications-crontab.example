# OKR Management — notification cron schedule.
#
# Install on the production host with: crontab -e, paste the lines below.
# Replace $CRON_SECRET with the value from .env and $BASE with the app URL (e.g. https://okr.example.com).
#
# All jobs are idempotent — running them more often than scheduled is safe
# but wasteful. The /api/cron/notifications endpoint dispatches by ?job=<name>.

# Daily digest drain — 07:00 local, every day
0 7 * * *  curl -fsS -X POST "$BASE/api/cron/notifications?job=daily&key=$CRON_SECRET" >/dev/null

# Weekly digest drain — Monday 07:05
5 7 * * 1  curl -fsS -X POST "$BASE/api/cron/notifications?job=weekly&key=$CRON_SECRET" >/dev/null

# Monthly digest drain — 1st of month 07:10
10 7 1 * * curl -fsS -X POST "$BASE/api/cron/notifications?job=monthly&key=$CRON_SECRET" >/dev/null

# Check-in missed escalation — every day at 09:00
0 9 * * *  curl -fsS -X POST "$BASE/api/cron/notifications?job=escalation&key=$CRON_SECRET" >/dev/null

# To-do reminders (due tomorrow + overdue) — every day at 08:00
0 8 * * *  curl -fsS -X POST "$BASE/api/cron/notifications?job=todos&key=$CRON_SECRET" >/dev/null

# Timeframe watcher (ending 7d / closing 1d / closed) — every day at 06:30
30 6 * * * curl -fsS -X POST "$BASE/api/cron/notifications?job=timeframes&key=$CRON_SECRET" >/dev/null

# Admin weekly health digest — Monday 07:15
15 7 * * 1 curl -fsS -X POST "$BASE/api/cron/notifications?job=admin-weekly&key=$CRON_SECRET" >/dev/null

# Admin monthly exec summary — 1st of month 07:20
20 7 1 * * curl -fsS -X POST "$BASE/api/cron/notifications?job=admin-monthly&key=$CRON_SECRET" >/dev/null

# Weekly per-user owner digest (existing endpoint) — Monday 07:25
25 7 * * 1 curl -fsS -X POST "$BASE/api/cron/weekly-digest?key=$CRON_SECRET" >/dev/null

# Daily auto-confidence recompute for stale (>14d) OKRs — every day at 03:00
0 3 * * *  curl -fsS -X POST "$BASE/api/cron/auto-confidence?key=$CRON_SECRET" >/dev/null
