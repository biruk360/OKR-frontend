# Database — PostgreSQL (see prisma/schema.prisma).
# Run: npx prisma migrate dev && npm run db:seed
# Example (local Postgres): DATABASE_URL="postgresql://postgres:password@localhost:5432/okr_system"
DATABASE_URL="postgresql://postgres:password@localhost:5432/okr_system"

# NextAuth.js — required for production; dev falls back to a local secret if unset.
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# If the app is served under a subpath (reverse proxy: /okr → app), set this and rebuild.
# Example: NEXT_PUBLIC_BASE_PATH="/okr" and NEXTAUTH_URL="https://your.domain/okr"
# NEXT_PUBLIC_BASE_PATH=""

# Pusher (for real-time updates)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
PUSHER_KEY="your-pusher-key"
PUSHER_CLUSTER="your-pusher-cluster"

# Optional: Email service for notifications (SMTP)
# To enable sending, set EMAIL_DRIVER="smtp"
EMAIL_DRIVER="log"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
# Set to "true" if using SSL (port 465). Defaults to true when port is 465.
# EMAIL_SERVER_SECURE="false"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourcompany.com"
EMAIL_FROM_NAME="OKR System"

# Client crash / error reporting to DB + server logs (set to "false" to disable browser reports)
# NEXT_PUBLIC_CLIENT_ERROR_REPORTING="false"

# AI providers — at least one key required when OrganizationSettings.aiSprintPlanningEnabled = true.
# The org's preferred provider is set via OrganizationSettings.aiPreferredProvider
# ("anthropic" | "openai" | "gemini"). See docs/AI_SPRINT_PLANNING.md §4.1.
# Keys are server-side only; never exposed to the client. A missing key for the
# requested provider returns 503 from /api/sprints/ai/generate.

# Anthropic (default provider)
ANTHROPIC_API_KEY=""
# AI_ANTHROPIC_PLANNER_MODEL="claude-sonnet-4-6"
# AI_ANTHROPIC_SUMMARY_MODEL="claude-haiku-4-5-20251001"

# OpenAI (ChatGPT). Default is the chat-completions GA model (fast, cheap).
# For reasoning / "thinking" mode use gpt-5.5-pro — routed automatically through the
# Responses API. ~4x slower and ~5x more expensive but produces sharper plans.
OPENAI_API_KEY=""
# AI_OPENAI_PLANNER_MODEL="gpt-5.5"      # alt: "gpt-5.5-pro" (reasoning, slow)
# AI_OPENAI_SUMMARY_MODEL="gpt-5.5-mini"

# Google Gemini
GEMINI_API_KEY=""
# AI_GEMINI_PLANNER_MODEL="gemini-2.5-pro"
# AI_GEMINI_SUMMARY_MODEL="gemini-2.5-flash"

# Daily org cap on AI generations across all providers (default 50). 429 returned when exceeded.
# AI_DAILY_GENERATION_CAP="50"

# Odoo integration — used by the Letter Management Customer typeahead (FR-3).
# When ALL four are set, /api/letters/odoo/contacts calls the real Odoo XML-RPC
# `res.partner.search_read`. When any is empty, the route falls back to a stub
# roster so the UI keeps working in dev.
# Create the API key under Odoo: Settings → Users & Companies → Users → (user) → API Keys.
# ODOO_URL="https://erp.360ground.com"
# ODOO_DB="erp_production"
# ODOO_USER="api-bot@360ground.com"
# ODOO_KEY=""

# Telegram bot integration. See docs/TELEGRAM_BOT.md.
# TELEGRAM_BOT_TOKEN: token from @BotFather (e.g. 1234567890:AAH...).
# TELEGRAM_WEBHOOK_SECRET: arbitrary long random string. Sent as the
#   X-Telegram-Bot-Api-Secret-Token header by Telegram on every webhook
#   request and verified by /api/telegram/webhook to reject spoofed traffic.
# TELEGRAM_PUBLIC_URL: HTTPS base URL Telegram will hit. Falls back to
#   NEXTAUTH_URL when unset. Must be reachable from the public internet.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_PUBLIC_URL="https://okr.360ground.com"
# Which provider answers /ask. "openai" (default) or "anthropic". Each requires
# its own API key (OPENAI_API_KEY / ANTHROPIC_API_KEY) in this file.
# TELEGRAM_AI_PROVIDER="openai"
# AI_OPENAI_TELEGRAM_MODEL="gpt-5.5"
# AI_ANTHROPIC_TELEGRAM_MODEL="claude-sonnet-4-6"

# ── Sign-in backdrop ────────────────────────────────────────────────────────
# The sign-in page rotates through Bing's published image-of-the-day archive,
# a different photo on every visit. The server fetches the metadata once every
# six hours; browsers load the photo files directly from bing.com.
#
# Set to "off" on an air-gapped or egress-restricted host — the page then uses
# its six built-in CSS scenes and makes no outbound request at all.
AUTH_WALLPAPER_SOURCE="bing"
# Bing market: drives which photo set and which caption language come back.
AUTH_WALLPAPER_MARKET="en-US"

# ── Public app URL / branding ───────────────────────────────────────────────
# Base URL used in links inside comment-notification emails (falls back to "").
# Usually the same as NEXTAUTH_URL. Also read by scripts/install-crontab.sh as the
# host the crontab curls (default http://localhost:3000).
# APP_URL="https://okr.360ground.com"
# Fallback company name when OrganizationSettings has no branding name.
# NEXT_PUBLIC_APP_NAME="360Ground"
# Browser-side Pusher credentials (the public key + cluster, NOT the secret).
# NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
# NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"

# ── Cron ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Every /api/cron/* route authenticates with
# `Authorization: Bearer $CRON_SECRET` (lib/cron-auth.ts) and FAILS CLOSED:
# unset, or shorter than 16 characters, means every cron call gets 503.
# Generate with: openssl rand -hex 32
# scripts/install-crontab.sh reads it from this file and refuses to run without it.
# After rotating: restart the app, then re-run scripts/install-crontab.sh.
CRON_SECRET=""

# ── Notifications ───────────────────────────────────────────────────────────
# Informational: the BATCHED notification cadence is drained by the crontab entry
# /api/cron/notifications?job=batch (every 10 minutes). The app does not read
# this variable — if you change the interval, change the crontab line to match.
# NOTIFICATION_BATCH_MINUTES="10"

# ── Retention (nightly /api/cron/prune-notifications) ───────────────────────
# Days to keep each append-only table. Defaults shown; values below 7 are ignored.
# See lib/retention/prune-tables.ts.
# RETENTION_EMAIL_DIGEST_DAYS="30"      # EmailDigestQueue — SENT rows only
# RETENTION_OUTBOUND_EMAIL_DAYS="90"    # OutboundEmail delivery log
# RETENTION_CLIENT_ERROR_DAYS="30"      # ClientErrorLog
# TELEGRAM_MESSAGE_RETENTION_DAYS="180" # TelegramMessage (scraped chat history)
# RETENTION_AI_GENERATION_DAYS="180"    # AiGenerationLog
# RETENTION_JIRA_SYNC_LOG_DAYS="30"     # JiraSyncLog

# ── Telegram /ask allowlist ─────────────────────────────────────────────────
# Comma/space separated chat ids allowed to use /ask (groups are negative, e.g.
# -1001234567890). Chats not listed are still scraped per their scrapeMode but
# /ask is refused. Empty = /ask refused everywhere.
# TELEGRAM_ALLOWED_CHAT_IDS=""

# ── Encryption keys (AES-256-GCM) ───────────────────────────────────────────
# Each must decode to exactly 32 bytes: 64 hex chars, or base64 (optionally
# prefixed "base64:"). Generate with: openssl rand -hex 32
# Changing a key makes everything encrypted with the old one unreadable —
# re-enter the stored credentials after a rotation.
# Jira API tokens stored on JiraConnection (Project Management → Jira).
# JIRA_TOKEN_ENCRYPTION_KEY=""
# AI provider API keys entered in-app (Settings → AI).
# AI_CREDENTIAL_ENCRYPTION_KEY=""

# ── New Project creation (upload / import / AI draft) ───────────────────────
# Private storage for uploaded source files. Must be writable by the app and
# OUTSIDE public/ (the app refuses a path under public/). Default:
# <os tmpdir>/okr-private/project-creation-uploads — set a persistent path in prod.
# PROJECT_CREATION_UPLOAD_DIR="/var/lib/okr/project-creation-uploads"
# ClamAV daemon (clamd) every upload is scanned by. Uploads are REFUSED when the
# host is unset or unreachable.
# PROJECT_CREATION_CLAMAV_HOST="127.0.0.1"
# PROJECT_CREATION_CLAMAV_PORT="3310"
# PROJECT_CREATION_CLAMAV_TIMEOUT_MS="10000"
# Abandoned creation drafts are purged by /api/cron/project-creation-draft-purge.
# PROJECT_CREATION_DRAFT_RETENTION_DAYS="30"
# Spreadsheet import limits.
# PROJECT_CREATION_IMPORT_MAX_FILE_BYTES="10485760"
# PROJECT_CREATION_IMPORT_MAX_ROWS="2000"
# Archive-safety and DOCX extraction bounds (defaults shown).
# PROJECT_CREATION_UPLOAD_MAX_ARCHIVE_ENTRIES="10000"
# PROJECT_CREATION_UPLOAD_MAX_ARCHIVE_ENTRY_BYTES="52428800"
# PROJECT_CREATION_UPLOAD_MAX_UNCOMPRESSED_BYTES="104857600"
# PROJECT_CREATION_UPLOAD_MAX_COMPRESSION_RATIO="100"
# PROJECT_CREATION_DOCX_MAX_BLOCKS="10000"
# PROJECT_CREATION_DOCX_MAX_CHARACTERS="500000"
# PROJECT_CREATION_DOCX_MAX_PAGES="200"

# ── Private attachment storage ──────────────────────────────────────────────
# All must be writable by the app and outside public/. Defaults under <app>/var/uploads/.
# UPLOAD_DIR="/var/lib/okr/uploads/comments"               # comment attachments
# TODO_UPLOAD_DIR="/var/lib/okr/uploads/todos"             # card attachments
# PROJECT_UPLOAD_DIR="/var/lib/okr/uploads/project-activities"

# ── PDF rendering (letters) ─────────────────────────────────────────────────
# Read by Puppeteer itself. Point at a system Chromium when the bundled download
# is unavailable (e.g. ARM hosts, or PUPPETEER_SKIP_DOWNLOAD at install time).
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# ── AI Automations worker (npm run worker:automations) ──────────────────────
# Idle poll interval in ms (default 5000).
# AUTOMATIONS_WORKER_POLL_MS="5000"

# ── Build / deploy ──────────────────────────────────────────────────────────
# Build into a scratch directory while the live .next keeps serving (deploy.sh).
# NEXT_DIST_DIR=".next"
