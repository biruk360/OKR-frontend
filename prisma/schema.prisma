// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production uses PostgreSQL (see env.example). `DATABASE_URL` is required.
  // Schema changes are applied via `prisma db push` from scripts/deploy.sh —
  // there is no migration history; `prisma/migrations/` is vestigial SQLite output.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums are represented as String for portability and simpler migrations

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  password               String?
  avatar                 String?
  role                   String    @default("EMPLOYEE") // ADMIN, EXECUTIVE, DEPARTMENT_LEAD, EMPLOYEE
  designation            String?   // Job title / position, e.g. "CEO", "Sales Engineer"
  nameAmharic            String?   // Full name in Amharic — used on Amharic letterhead
  designationAmharic     String?   // Job title in Amharic — used on Amharic letterhead
  isActive               Boolean   @default(true)
  activationToken        String?
  activationTokenExpires DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relationships
  ownedObjectives             Objective[]              @relation("ObjectiveOwner")
  ownedKeyResults             KeyResult[]              @relation("KeyResultOwner")
  assignedTodos               Todo[]                   @relation("TodoAssignee")
  createdTodos                Todo[]                   @relation("TodoCreator")
  keyResultCheckIns           KeyResultCheckIn[]
  comments                    Comment[]
  notifications               Notification[]
  departmentMemberships       DepartmentMembership[]
  managerRelationships        ManagerRelationship[]    @relation("Manager")
  directReports               ManagerRelationship[]    @relation("DirectReport")
  clientErrorLogs             ClientErrorLog[]
  activityLogs                ActivityLog[]
  objectiveViews              ObjectiveView[]
  keyResultViews              KeyResultView[]
  objectiveContributions      ObjectiveContributor[]
  ownedSprints                Sprint[]                 @relation("SprintOwner")
  emailDigestSent             EmailDigestState?
  initiativeUpdates           InitiativeUpdate[]       @relation("InitiativeUpdateAuthor")
  userPreferences             UserPreference?
  notificationPrefs           NotificationPreference[]
  watchers                    Watcher[]
  favorites                   Favorite[]
  todoMembers                 TodoMember[]             @relation("TodoMemberUser")
  todoChecklistItems          TodoChecklistItem[]      @relation("TodoChecklistItemAssignee")
  todoAttachments             TodoAttachment[]         @relation("TodoAttachmentUploader")
  todoComments                TodoComment[]            @relation("TodoCommentAuthor")
  reportedRisks               Risk[]                   @relation("RiskReporter")
  sprintParticipations        SprintParticipant[]      @relation("SprintParticipantUser")
  sprintsEnded                Sprint[]                 @relation("SprintEndedBy")
  ceoOf                       OrganizationSettings?    @relation("OrgSettingsCeo")
  // Daily Trip Plan back-relations (see prisma/schema.prisma DTP block at the bottom).
  dtpRequestedPlans           DailyTripPlan[]          @relation("DtpRequester")
  dtpDecidedPlans             DailyTripPlan[]          @relation("DtpDecidedBy")
  dtpEvents                   DtpEvent[]               @relation("DtpEventActor")
  driverProfile               Driver?                  @relation("DriverUser")
  // Letter Management back-relations.
  preparedLetters             Letter[]                 @relation("LetterPreparedBy")
  signatoryLetters            Letter[]                 @relation("LetterSignatory")
  uploadedEnclosures          LetterEnclosure[]        @relation("LetterEnclosureUploader")
  createdLetterTypes          LetterTypeDef[]          @relation("LetterTypeCreator")
  letterRolePermissionsSet    LetterRolePermission[]   @relation("LetterRolePermissionUpdater")
  letterUserPermissions       LetterUserPermission[]   @relation("LetterUserPermissionTarget")
  letterUserPermissionsSet    LetterUserPermission[]   @relation("LetterUserPermissionUpdater")
  userRoles              UserRole[]         @relation("UserRoles")
  userRoleProfiles       UserRoleProfile[]  @relation("UserRoleProfiles")
  permissionOverrides    UserPermissionOverride[] @relation("UserPermissionOverrides")
  performanceTemplateAssignments EmployeeTemplateAssignment[] @relation("PerformanceTemplateEmployee")
  performanceMetricMappings      MetricSourceMapping[]         @relation("PerformanceMetricEmployee")
  performanceEvaluations         Evaluation[]                  @relation("PerformanceEvaluationEmployee")
  performanceEvaluatorAssignments EvaluatorAssignment[]        @relation("PerformanceEvaluator")
  performanceEvaluatorScores      EvaluatorScore[]             @relation("PerformanceScoreEvaluator")
  performanceImprovementFocuses   ImprovementFocus[]           @relation("PerformanceFocusEmployee")

  @@map("users")
}

/// User-starred OKRs surfaced under the "Watched" tab of the OKR Explorer.
/// Per-user, per-entity. Extend entityType to KEY_RESULT / TODO later.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String // "OBJECTIVE" for now
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@map("favorites")
}

/// Stores per-user UI preferences (sidebar vs modal for todo view, etc).
model UserPreference {
  userId       String   @id
  todoViewMode String   @default("modal") // "modal" | "sidebar"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberships DepartmentMembership[]
  objectives  Objective[]
  sprints     Sprint[]
  parentId    String?
  parent      Department?  @relation("DeptChildren", fields: [parentId], references: [id])
  children    Department[] @relation("DeptChildren")
  performanceTemplateMappings TemplateRoleMapping[]
  performanceCycleScopes      ReviewCycleDepartment[]

  @@map("departments")
}

/// Membership of a user in a department.
/// `role` is one of HEAD | MEMBER | SECONDARY_MEMBER (string-stored enum).
/// `legacyRole` retains the pre-2026-05 free-text value for backfill auditing
/// and is dropped in a follow-up migration once `role` is fully populated.
/// `isPrimary` marks the user's primary department (exactly one active row per user).
/// `endedAt` enables soft-removal + history; null means active membership.
model DepartmentMembership {
  id           String    @id @default(cuid())
  userId       String
  departmentId String
  role         String    @default("MEMBER") // HEAD | MEMBER | SECONDARY_MEMBER
  legacyRole   String? // backfill-only; dropped after data migration
  isPrimary    Boolean   @default(true)
  joinedAt     DateTime  @default(now())
  endedAt      DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_memberships")
}

model ManagerRelationship {
  id             String    @id @default(cuid())
  managerId      String
  directReportId String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  manager      User @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)
  directReport User @relation("DirectReport", fields: [directReportId], references: [id], onDelete: Cascade)

  @@unique([managerId, directReportId])
  @@index([managerId])
  @@index([directReportId])
  @@map("manager_relationships")
}

/// Singleton row (id = "singleton") holding company-wide settings:
/// the CEO designation and feature flags for org structure.
model OrganizationSettings {
  id                      String   @id @default("singleton")
  companyName             String   @default("My Company")
  companyCeoUserId        String?  @unique
  allowMatrixReporting    Boolean  @default(false)
  allowMultipleDeptHeads  Boolean  @default(false)
  /// Master switch for the AI Sprint Planning feature (see docs/AI_SPRINT_PLANNING.md).
  /// When false, /api/sprints/ai/* routes return 404 and the "AI Plan" button is hidden.
  aiSprintPlanningEnabled Boolean  @default(false)
  /// Default AI provider when a /generate call doesn't specify one.
  /// One of "anthropic" | "openai" | "gemini".
  aiPreferredProvider     String   @default("anthropic")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ceo User? @relation("OrgSettingsCeo", fields: [companyCeoUserId], references: [id], onDelete: SetNull)

  @@map("organization_settings")
}

model Timeframe {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Q1 2025", "H2 2025", "January 2025"
  type      String   @default("QUARTERLY") // MONTHLY, QUARTERLY, SIX_MONTH, YEARLY
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  objectives Objective[]

  @@map("timeframes")
}

model Objective {
  id                String    @id @default(cuid())
  title             String
  description       String?
  level             String // COMPANY, DEPARTMENT, INDIVIDUAL
  status            String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  goalStatus        String    @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, CLOSED
  progress          Float     @default(0) // Calculated from Key Results
  // Owner-reported objective-level confidence (0-100). Read by Apple Pro hero/right-rail.
  // NOTE: requires `prisma db push` on deploy — preflight.sql already runs in CI.
  confidence        Int       @default(50)
  isPrivate         Boolean   @default(false) // Visibility: false = Public, true = Private
  startDate         DateTime?
  endDate           DateTime?
  ownerId           String
  timeframeId       String
  departmentId      String?
  parentObjectiveId String?
  /// LOOSE = visual alignment only; STRICT_DEPENDENCY = progress can roll up from active child objectives
  alignmentType     String    @default("LOOSE")
  /// NONE | AVERAGE | SUM — used only when alignmentType is STRICT_DEPENDENCY and there are active children
  rollupCalculation String    @default("NONE")
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence    String    @default("WEEKLY")
  /// Raw weight used when this objective contributes to a parent's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  /// Otherwise, the relative weight among siblings determines contribution %.
  weight            Float     @default(0)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  owner            User                   @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  timeframe        Timeframe              @relation(fields: [timeframeId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  parentObjective  Objective?             @relation("ObjectiveHierarchy", fields: [parentObjectiveId], references: [id])
  childObjectives  Objective[]            @relation("ObjectiveHierarchy")
  keyResults       KeyResult[]
  comments         Comment[]
  objectiveLabels  ObjectiveLabel[]
  activityLogs     ActivityLog[]
  views            ObjectiveView[]
  todos            Todo[]                 @relation("TodoObjective")
  contributors     ObjectiveContributor[]
  risks            Risk[]
  projects         Project[] // Project Management module — projects linked to this objective (K1)
  scrumLinks       ScrumUpdateLink[]

  @@index([departmentId])
  @@index([ownerId])
  @@map("objectives")
}

/// Additional people collaborating on an objective besides the sole owner.
/// Contributors can edit KRs and check in; they do NOT inherit admin rights.
model ObjectiveContributor {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  addedAt     DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId])
  @@index([userId])
  @@map("objective_contributors")
}

model KeyResult {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startValue     Float     @default(0)
  targetValue    Float
  currentValue   Float     @default(0)
  unit           String // e.g., "%", "users", "$"
  confidence     String    @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK
  progress       Float     @default(0) // Calculated from currentValue/targetValue
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  isPrivate      Boolean   @default(false) // Visibility: false = Public, true = Private
  ownerId        String
  objectiveId    String
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence String    @default("WEEKLY")
  /// Raw weight used when this KR contributes to its parent objective's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  weight         Float     @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  owner            User               @relation("KeyResultOwner", fields: [ownerId], references: [id])
  objective        Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  todos            Todo[] // Renamed conceptually to "Initiative" in the UI; table is `initiatives`
  comments         Comment[]
  checkIns         KeyResultCheckIn[]
  activityLogs     ActivityLog[]
  views            KeyResultView[]
  risks            Risk[]
  performanceMetricMappings MetricSourceMapping[]
  performanceMetricSources  EvaluationMetricSource[]
  milestones       Milestone[] // Project Management module — milestones driving this KR (K1)
  scrumLinks       ScrumUpdateLink[]

  @@map("key_results")
}

model KeyResultCheckIn {
  id              String   @id @default(cuid())
  keyResultId     String
  asOfDate        DateTime
  value           Float
  /// Legacy enum-style tier kept for backward compatibility (ON_TRACK | AT_RISK | OFF_TRACK).
  /// New writes should also set `confidenceScore`; reads should prefer it.
  confidence      String
  /// Numeric 0-100 confidence captured from the Apple-style slider.
  /// Default 50 keeps existing rows valid until backfilled (see scripts/preflight.sql).
  confidenceScore Int      @default(50)
  analysis        String?
  createdById     String
  createdAt       DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([keyResultId, asOfDate])
  @@map("key_result_check_ins")
}

/// Initiative / To-do — actionable work item.
/// Can be standalone (personal to-do), linked to a Key Result, or linked to an
/// Objective. The Prisma model name stays `Todo` so existing code paths keep
/// working; the underlying table is `initiatives` and user-facing labels say
/// "To-do" on the dedicated page and "Initiative" when shown under a KR.
model Todo {
  id                    String    @id @default(cuid())
  title                 String
  description           String?
  status                String    @default("PENDING") // PENDING, IN_PROGRESS, IN_REVIEW, STUCK, COMPLETED, CANCELLED
  priority              String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  coverColor            String? // hex or named colour for the card cover strip
  startDate             DateTime?
  dueDate               DateTime?
  /// Wall-clock start/end time on the planner ("HH:mm"). Optional — todos
  /// without times render as all-day chips on the per-sprint Planner view.
  startTime             String?
  endTime               String?
  completedAt           DateTime?
  /// Optional primary assignee (legacy — Trello-style usage relies on TodoMember
  /// instead). Kept nullable for filters/notifications/legacy queries.
  assigneeId            String?
  creatorId             String
  /// Optional link to a Key Result — when set, the todo contributes toward KR work.
  keyResultId           String?
  /// Optional link to an Objective — use when the work spans a whole objective
  /// rather than a single KR. Mutually informative with keyResultId; both can be set.
  objectiveId           String?
  /// Numeric contribution in the parent KR's unit (ETB, pcs, qty, hours, %, …).
  /// When the initiative is marked COMPLETED, this value is summed into the
  /// parent KR's currentValue (see lib/objectiveProgress.ts → recalcKrFromInitiatives).
  progressValue         Float?
  /// Sprint v2 (Phase 1) — optional link to a Sprint. Allows todos to participate in
  /// the unified Sprint+Todo board planned for Phase 3. SetNull on sprint delete.
  sprintId              String?
  /// Card order within the sprint board lane. Higher = lower in list. Per-lane via (sprintId, status, sprintPosition).
  sprintPosition        Int       @default(0)
  /// Card order within a status column on the global todo kanban. Higher = lower in list.
  sortOrder             Int       @default(0)
  /// Free-form task type tag (CALL, EMAIL, DEMO, MEETING, PROPOSAL, FOLLOW_UP, ADMIN, GENERAL).
  taskType              String?
  /// AI Sprint Planning (see docs/AI_SPRINT_PLANNING.md) — true when the row was
  /// generated by the AI sprint planner, false when manually created.
  aiSuggested           Boolean   @default(false)
  /// COMMITTED | STRETCH — set on AI-suggested rows so the user can drop stretch tasks.
  ambitionLevel         String?
  /// Sprint id where this todo was first created. Preserved across SPLIT carryovers
  /// so we can trace lineage back to the original sprint.
  originalSprintId      String?
  /// How many prior sprints this todo has been carried into. 0 for a fresh todo.
  /// >=2 disallows plain KEEP disposition — must be SPLIT/DESCOPE/ESCALATE.
  carryoverCount        Int       @default(0)
  /// When the row was last carried over to a new sprint.
  lastCarriedAt         DateTime?
  /// When SPLIT was applied, points at the cuid that groups the resulting child todos.
  carryoverReplacedById String?
  /// KEEP | SPLIT | RESCHEDULE | DESCOPE | ESCALATE — last carryover decision applied.
  /// Null on first creation.
  carryoverDisposition  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  assignee  User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  creator   User       @relation("TodoCreator", fields: [creatorId], references: [id])
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  objective Objective? @relation("TodoObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  initiativeUpdates InitiativeUpdate[]
  members           TodoMember[]
  labels            TodoLabel[]
  checklists        TodoChecklist[]
  attachments       TodoAttachment[]
  todoComments      TodoComment[]
  activityLogs      ActivityLog[]
  scrumLinks        ScrumUpdateLink[]

  @@index([assigneeId, status])
  @@index([creatorId, status])
  @@index([sprintId])
  @@index([taskType])
  @@index([sprintId, status])
  @@index([sprintId, status, sprintPosition])
  @@index([status, sortOrder])
  @@index([originalSprintId])
  @@index([carryoverCount])
  @@map("initiatives")
}

/// Additional members on a todo (beyond the single primary assignee).
model TodoMember {
  id      String   @id @default(cuid())
  todoId  String
  userId  String
  addedAt DateTime @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation("TodoMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId])
  @@map("todo_members")
}

/// Coloured label attached to a todo. Label definitions live in TodoLabelDef.
model TodoLabel {
  id         String   @id @default(cuid())
  todoId     String
  labelDefId String
  createdAt  DateTime @default(now())

  todo     Todo         @relation(fields: [todoId], references: [id], onDelete: Cascade)
  labelDef TodoLabelDef @relation(fields: [labelDefId], references: [id], onDelete: Cascade)

  @@unique([todoId, labelDefId])
  @@map("todo_labels")
}

/// Board-wide label palette (name + color). Shared across all todos.
model TodoLabelDef {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366F1") // indigo default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoLabels TodoLabel[]

  @@map("todo_label_defs")
}

/// A named checklist group on a todo (a card can have multiple checklists).
model TodoChecklist {
  id        String   @id @default(cuid())
  todoId    String
  title     String   @default("Checklist")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo  Todo                @relation(fields: [todoId], references: [id], onDelete: Cascade)
  items TodoChecklistItem[]

  @@index([todoId, position])
  @@map("todo_checklists")
}

/// Individual item within a checklist.
model TodoChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completed   Boolean   @default(false)
  assigneeId  String?
  startDate   DateTime?
  dueDate     DateTime?
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist TodoChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TodoChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@map("todo_checklist_items")
}

/// File attachment on a todo. Stores the file URL (uploaded to storage) + metadata.
model TodoAttachment {
  id           String   @id @default(cuid())
  todoId       String
  uploadedById String
  filename     String
  url          String // storage URL (local path or CDN)
  mimeType     String
  size         Int // bytes
  createdAt    DateTime @default(now())

  todo       Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TodoAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@map("todo_attachments")
}

/// WYSIWYG comment thread on a todo. Separate from InitiativeUpdate (daily updates).
model TodoComment {
  id                 String   @id @default(cuid())
  todoId             String
  authorId           String
  content            String // HTML from Tiptap
  parentId           String? // for threaded replies
  /// JSON-encoded array of TodoAttachment ids that should render inline with this comment.
  /// Stored as a string (rather than relation) to avoid invasive M2M migration.
  commentAttachments String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  todo    Todo          @relation(fields: [todoId], references: [id], onDelete: Cascade)
  author  User          @relation("TodoCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  TodoComment?  @relation("TodoCommentReplies", fields: [parentId], references: [id])
  replies TodoComment[] @relation("TodoCommentReplies")

  @@index([todoId, createdAt])
  @@map("todo_comments")
}

/// Mandatory daily update on an initiative. One row per (initiative, date).
/// The report page renders a day-by-day grid from these rows.
model InitiativeUpdate {
  id           String   @id @default(cuid())
  initiativeId String
  authorId     String
  updateDate   String // YYYY-MM-DD bucket
  content      String
  status       String? // optional status snapshot at time of update
  blockers     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiative Todo @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  author     User @relation("InitiativeUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, updateDate])
  @@index([updateDate])
  @@index([authorId, updateDate])
  @@map("initiative_updates")
}

/// Bi-weekly auto-calculated confidence snapshot for an objective or key result.
/// Stored once per entity per calculation period so the system keeps a history
/// of confidence transitions over time.
model ConfidenceSnapshot {
  id           String   @id @default(cuid())
  entityType   String // OBJECTIVE | KEY_RESULT
  entityId     String
  periodStart  String // YYYY-MM-DD (the first day of the bi-weekly period)
  confidence   String // ON_TRACK | AT_RISK | OFF_TRACK
  score        Float // 0-100 computed score
  factors      String? // JSON: { progressPct, timeElapsedPct, velocity, ... }
  previousConf String? // previous confidence for delta detection
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, periodStart])
  @@index([entityType, periodStart])
  @@map("confidence_snapshots")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorId    String
  objectiveId String?
  keyResultId String?
  parentId    String? // For nested comments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  author    User       @relation(fields: [authorId], references: [id])
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]  @relation("CommentReplies")

  @@map("comments")
}

/// In-app notification row. One row per (user, event) recipient.
/// `eventKey` is the canonical event code from lib/notifications/events.ts (e.g. "KR_AT_RISK").
/// `category` buckets multiple events for preference toggling (see NotificationPreference).
/// Email-related columns track the companion OutboundEmail send (if any).
model Notification {
  id              String    @id @default(cuid())
  type            String // legacy OBJECTIVE_CREATED etc. — kept for backwards compat
  eventKey        String? // canonical event code (e.g. "KR_AT_RISK")
  category        String? // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  title           String
  message         String
  isRead          Boolean   @default(false)
  userId          String
  metadata        String? // JSON: { objectiveId?, keyResultId?, todoId?, actorId?, entityTitle?, redacted? }
  /// When true, the recipient should NOT see the entity title/values — dispatcher already
  /// wrote placeholder text into `title`/`message`, but downstream deep-link rendering
  /// should continue to respect isPrivate on the linked entity.
  redacted        Boolean   @default(false)
  /// Companion email delivery fields (null if no email was intended for this row).
  emailMode       String? // IMMEDIATE | DIGEST_DAILY | DIGEST_WEEKLY | DIGEST_MONTHLY | DISABLED
  emailSent       Boolean   @default(false)
  emailAt         DateTime?
  outboundEmailId String? // FK-ish pointer to OutboundEmail.id (no FK — OutboundEmail rows may be pruned)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([eventKey, createdAt])
  @@map("notifications")
}

/// Per-user notification preferences. One row per (user, category).
/// `inApp` / `email` toggle each channel. `emailCadence` controls batching for this category.
/// Missing rows fall back to the org defaults in OrgNotificationDefault.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  category     String // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE") // IMMEDIATE | DAILY | WEEKLY | DISABLED
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// Org-level notification defaults set by Admin in Settings. Applied when the user has no
/// explicit NotificationPreference row for a category. One row per category.
model OrgNotificationDefault {
  id           String   @id @default(cuid())
  category     String   @unique
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("org_notification_defaults")
}

/// Opt-in watchers on an entity (objective, KR, or todo). Watchers receive dispatcher events
/// matching their subscription. Use the composite key to scope.
model Watcher {
  id         String   @id @default(cuid())
  userId     String
  entityType String // OBJECTIVE | KEY_RESULT | TODO
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("watchers")
}

/// Pending email digest entries. The dispatcher writes here when a user's preference for
/// a category is DAILY/WEEKLY/MONTHLY instead of IMMEDIATE. The digest cron drains these
/// rows into bundled OutboundEmail rows.
model EmailDigestQueue {
  id       String    @id @default(cuid())
  userId   String
  cadence  String // DAILY | WEEKLY | MONTHLY
  category String
  eventKey String
  subject  String
  bodyText String
  bodyHtml String?
  metadata String? // JSON: { entityType, entityId, redacted, ... }
  queuedAt DateTime  @default(now())
  sentAt   DateTime?

  @@index([userId, cadence, sentAt])
  @@index([sentAt])
  @@map("email_digest_queue")
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Client-side crashes, unhandled rejections, and React error boundaries (troubleshooting).
model ClientErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  route     String?
  userAgent String?
  userId    String?
  digest    String?
  extra     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source])
  @@map("client_error_logs")
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3B82F6") // Default blue color
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectiveLabels ObjectiveLabel[]

  @@map("labels")
}

model ObjectiveLabel {
  id          String   @id @default(cuid())
  objectiveId String
  labelId     String
  createdAt   DateTime @default(now())

  // Relationships
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, labelId])
  @@map("objective_labels")
}

/// Activity log — append-only audit trail for objectives and key results.
/// One row per change. `action` is short ("CREATED", "UPDATED", "STATUS_CHANGED", "PROGRESS_UPDATED",
/// "ARCHIVED", "UNARCHIVED", "DELETED", "CHECKIN", "VIEWED", "COMMENTED", "INITIATIVE_ADDED", ...).
/// `changes` is a JSON string: `{ field: { from: any, to: any }, ... }`.
model ActivityLog {
  id          String   @id @default(cuid())
  entityType  String // OBJECTIVE | KEY_RESULT | TODO | SPRINT | LETTER | EVALUATION | REVIEW_CYCLE | DEVELOPMENT_ACTION | PERFORMANCE_SETTINGS
  objectiveId String?
  keyResultId String?
  todoId      String?
  /// Sprint v2 (Phase 1) — optional sprint association for sprint lifecycle events.
  sprintId    String?
  /// Letter Management — optional letter association for letter lifecycle events.
  letterId    String?
  /// Performance module — optional evaluation association for evaluation, cycle,
  /// and development-action lifecycle events (cycle/action ids live in metadata).
  evaluationId String?
  /// Project Management module — optional project association for project, phase,
  /// milestone, activity, baseline, delay, and register lifecycle events
  /// (child entity ids live in metadata).
  projectId   String?
  action      String
  actorId     String?
  /// JSONB on Postgres — `{ field: { from, to } }`. Was `String` (JSON-encoded) before
  /// the 2026-04-14 migration; existing rows were converted with `changes::jsonb`.
  changes     Json?
  /// JSONB on Postgres — extra context (e.g. ip, source page, snippet).
  metadata    Json?
  createdAt   DateTime @default(now())

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  todo      Todo?      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  letter    Letter?    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@index([keyResultId, createdAt])
  @@index([todoId, createdAt])
  @@index([sprintId, createdAt])
  @@index([letterId, createdAt])
  @@index([evaluationId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

/// View tracking — capped to one row per (user, objective, day) by unique constraint
/// to keep storage bounded while still answering "who viewed and when".
model ObjectiveView {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  viewDate    String // YYYY-MM-DD bucket — enables one-row-per-day uniqueness
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId, viewDate])
  @@index([objectiveId, lastViewAt])
  @@map("objective_views")
}

model KeyResultView {
  id          String   @id @default(cuid())
  keyResultId String
  userId      String
  viewDate    String
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, userId, viewDate])
  @@index([keyResultId, lastViewAt])
  @@map("key_result_views")
}

/// Sprint planning — Trello-style board for marketing/business teams.
/// Columns are dynamic per-sprint and become the activity status.
model Sprint {
  id             String    @id @default(cuid())
  name           String
  description    String?
  ownerId        String
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED — legacy, kept for backward compat
  // Sprint v2 (Phase 1) — additive lifecycle/state model.
  state          String    @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, CANCELLED
  goal           String?
  goalLabel      String?
  goalTarget     Float?
  goalCurrent    Float?    @default(0)
  goalUnit       String?
  /// Trello-style board background preset key (see lib/sprint-backgrounds.ts).
  /// "none" = neutral surface; otherwise one of the gradient preset keys.
  background     String?   @default("none")
  departmentId   String?
  reflectionNote String?
  endedAt        DateTime?
  endedById      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User                @relation("SprintOwner", fields: [ownerId], references: [id])
  columns      SprintColumn[]
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  endedBy      User?               @relation("SprintEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  participants SprintParticipant[]
  todos        Todo[]
  activityLogs ActivityLog[]
  aiPlans      AiSprintPlan[]

  @@index([ownerId, status])
  @@index([state, endDate])
  @@index([departmentId])
  @@map("sprints")
}

/// Sprint v2 — explicit sprint membership. MEMBER for participants, OWNER mirrors creator.
model SprintParticipant {
  id       String   @id @default(cuid())
  sprintId String
  userId   String
  role     String   @default("MEMBER") // MEMBER, OWNER
  joinedAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation("SprintParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([userId])
  @@map("sprint_participants")
}

model SprintColumn {
  id        String   @id @default(cuid())
  sprintId  String
  name      String
  /// Global TodoStatus this lane represents (PENDING, IN_PROGRESS, IN_REVIEW, STUCK, COMPLETED).
  /// Each sprint has exactly one row per board status; lane order on the board is driven by `position`.
  statusKey String?
  position  Int      @default(0)
  color     String? // optional accent color for the column header
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, name])
  @@unique([sprintId, statusKey])
  @@index([sprintId, position])
  @@map("sprint_columns")
}

/// Tracks last sent weekly digest per user (idempotency for the Monday job).
model EmailDigestState {
  userId            String    @id
  lastSentAt        DateTime?
  lastDigestCadence String? // "WEEKLY" — extensible
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_digest_state")
}

/// Outbound email queue — when SMTP isn't wired yet, every send lands here as a row
/// AND is mirrored to server logs. Once SMTP is configured, a worker can drain `status='PENDING'`.
model OutboundEmail {
  id        String    @id @default(cuid())
  toEmail   String
  toName    String?
  subject   String
  bodyText  String
  bodyHtml  String?
  template  String? // identifier of the template that produced this row
  metadata  String? // JSON context
  status    String    @default("PENDING") // PENDING | SENT | FAILED | LOGGED_ONLY
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("outbound_emails")
}

/// Risks flagged on an Objective or Key Result. Polymorphic — exactly one of
/// objectiveId / keyResultId is set. Severity + status are stored as String
/// to match the rest of the schema's enum-as-String convention.
model Risk {
  id          String  @id @default(cuid())
  title       String
  description String?
  severity    String // LOW | MEDIUM | HIGH | CRITICAL
  status      String  @default("OPEN") // OPEN | MITIGATING | RESOLVED | ACCEPTED
  mitigation  String?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResultId String?
  keyResult   KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("RiskReporter", fields: [reporterId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([objectiveId])
  @@index([keyResultId])
  @@index([status])
  @@map("risks")
}

/// AI-generated draft sprint plan. One row per Sprint that was produced by the AI planner.
/// See docs/AI_SPRINT_PLANNING.md for the full spec, allocations JSON shape, and acceptance criteria.
model AiSprintPlan {
  id               String    @id @default(cuid())
  /// One sprint may now have multiple plans — one per (subjectUserId) when a lead
  /// runs AI generation for several team members into the same team sprint.
  /// Uniqueness is enforced at app-level via the (sprintId, subjectUserId, status='DRAFT') idempotency check.
  sprintId         String
  subjectUserId    String?
  subjectDeptId    String?
  generatedById    String
  /// "anthropic" | "openai" | "gemini" — which provider produced this plan.
  provider         String    @default("anthropic")
  modelId          String
  promptTokens     Int       @default(0)
  outputTokens     Int       @default(0)
  cachedTokens     Int       @default(0)
  rationale        String
  /// Array<{ keyResultId, weightShare, timeBudgetPct, plannedDelta, carryoverDelta, velocityFactor, carryoverItemIds[] }>
  allocations      Json
  /// { completed, planned, blockers[], krDeltas[] } — null on first sprint.
  prevSprintReview Json?
  /// { total, kept, split, rescheduled, descoped, escalated, blockers[] }
  carryoverSummary Json?
  /// User instruction text supplied on regenerate. Null on initial draft.
  feedback         String?
  /// DRAFT | ACCEPTED | DISCARDED | SUPERSEDED
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId, status])
  @@index([subjectUserId, createdAt])
  @@index([status, createdAt])
  @@map("ai_sprint_plans")
}

/// Per-call audit row for every AI generation across the system. Used by the admin
/// observability surface (docs/AI_SPRINT_PLANNING.md §3.6) for cost rollups, cache-hit
/// telemetry, and error tracking.
model AiGenerationLog {
  id           String   @id @default(cuid())
  userId       String
  /// Free-form feature key — "SPRINT_PLAN" today; new AI surfaces add their own key.
  feature      String
  /// "anthropic" | "openai" | "gemini" — which provider was called.
  provider     String   @default("anthropic")
  modelId      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  /// Total estimated cost in USD for this single call.
  costUsd      Float    @default(0)
  /// End-to-end latency in milliseconds (request start → tool-use response parsed).
  latencyMs    Int?
  /// OK | ERROR
  status       String
  errorMessage String?
  /// Raw AI response body — the parsed plan object the provider returned. Stored
  /// so post-mortems on empty/odd plans can see exactly what the model produced
  /// without re-running the call. Null for ERROR rows where parsing failed before
  /// a body was returned. Truncated to top-level fields on the largest payloads.
  responseJson Json?
  /// Optional foreign key to AiSprintPlan when feature == SPRINT_PLAN. Loose pointer
  /// (no FK) so we can prune plans without losing the audit trail.
  planId       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@map("ai_generation_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Daily Trip Plan (DTP) — Travel & Mobility module.
// Spec: docs/Daily_Trip_Plan_Requirements_v1.0.md
// All status / mode / type fields are stored as String for portability — see
// types/dtp.ts for the canonical literal unions.
// ─────────────────────────────────────────────────────────────────────────────

/// Vehicle registry. Capacity is the max number of seated passengers
/// (driver excluded). `defaultDriverId` is the driver normally paired with
/// this vehicle — Pool Coordinator can override per day.
model Vehicle {
  id              String   @id @default(cuid())
  plate           String   @unique
  model           String?
  capacity        Int      @default(4)
  defaultDriverId String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  defaultDriver Driver?         @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id])
  drivers       Driver[]        @relation("DriverDefaultVehicle")
  runSheets     DailyRunSheet[]
  legs          TripLeg[]

  @@map("dtp_vehicles")
}

/// Driver registry. `userId` links to a `User` row when the driver also has a
/// platform account (so they can sign in to the run-sheet view); nullable for
/// external/contract drivers.
model Driver {
  id               String   @id @default(cuid())
  userId           String?  @unique
  fullName         String
  phone            String?
  license          String?
  photoUrl         String?
  defaultVehicleId String?
  isActive         Boolean  @default(true)
  workStart        String? // "08:30" (HH:MM); falls back to office working hours
  workEnd          String? // "17:30"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User?           @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  defaultVehicle    Vehicle?        @relation("DriverDefaultVehicle", fields: [defaultVehicleId], references: [id])
  vehiclesAsDefault Vehicle[]       @relation("VehicleDefaultDriver")
  runSheets         DailyRunSheet[]
  legs              TripLeg[]

  @@map("dtp_drivers")
}

/// Customizable trip-type (purpose) registry. Drives the icon, color, and
/// default dwell minutes pre-filled on a stop. Seeded with the spec's defaults.
model DtpTripType {
  id              String   @id @default(cuid())
  code            String   @unique // "MEETING", "BANK_VISIT", ...
  label           String
  icon            String? // lucide icon name
  color           String? // hex
  defaultDwellMin Int      @default(60)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops TripStop[]

  @@map("dtp_trip_types")
}

/// Per-department approval routing for DTP. `null` department = org-wide default.
/// `primaryCoordinatorId` and `alternateCoordinatorId` reference users.
model DtpDepartmentApproval {
  id                     String   @id @default(cuid())
  departmentId           String?  @unique // null = org default
  primaryCoordinatorId   String?
  alternateCoordinatorId String?
  failoverHours          Int      @default(4)
  managerEndorsementMode String   @default("OFF") // OFF | ADVISORY | REQUIRED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([departmentId])
  @@map("dtp_department_approvals")
}

/// Singleton-ish row keyed by id="default". Holds org-wide settings that aren't
/// per-department. Editable from /dashboard/settings/travel.
model DtpSettings {
  id                                  String   @id @default("default")
  // SLAs
  submissionCutoff                    String   @default("17:00") // HH:MM
  approvalSlaTime                     String   @default("08:30") // HH:MM same-day-of-trip
  // Working hours / geofence / defaults
  officeAnchorLat                     Float    @default(9.0192) // Addis Ababa fallback
  officeAnchorLng                     Float    @default(38.7525)
  officeLabel                         String   @default("Head Office")
  workStart                           String   @default("08:30")
  workEnd                             String   @default("17:30")
  sameAreaRadiusM                     Int      @default(800)
  defaultTripMode                     String   @default("ROUND_TRIP") // ROUND_TRIP | ONE_WAY
  // Traffic
  trafficAware                        Boolean  @default(true)
  trafficModel                        String   @default("best_guess") // best_guess | optimistic | pessimistic
  trafficBufferPct                    Int      @default(10)
  // Optimization
  optimizationEnabled                 Boolean  @default(true)
  optimizationMaxGroupSize            Int      @default(4)
  optimizationMaxDetourMin            Int      @default(15)
  optimizationMaxPassengersPerVehicle Int      @default(4)
  // Adjustment / acknowledgement
  adjustmentRequiresAcknowledgement   Boolean  @default(true)
  // Pool Coordinator user IDs (CSV) — comma-separated user.id list. Plain CSV
  // keeps schema portable (no Postgres array dep) and the list is small.
  poolCoordinatorIds                  String   @default("")
  // Operations Manager IDs (CSV) — read-all + override authority.
  operationsManagerIds                String   @default("")
  // Notification channels
  notifyEmail                         Boolean  @default(true)
  notifyInApp                         Boolean  @default(true)
  notifySms                           Boolean  @default(false)
  notifyTelegram                      Boolean  @default(false)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@map("dtp_settings")
}

/// One Daily Trip Plan per (requester, trip_date). Header for the day.
/// Stops live in `TripStop`; legs (driver-level work) in `TripLeg`.
model DailyTripPlan {
  id                      String    @id @default(cuid())
  requesterId             String
  departmentId            String? // resolved at submission time from primary membership
  tripDate                DateTime // calendar date (time component ignored)
  status                  String    @default("DRAFT")
  // Statuses: DRAFT | SUBMITTED | MANAGER_ENDORSED | UNDER_REVIEW | RETURNED |
  //           ADJUSTED | APPROVED | DRIVER_ASSIGNED | IN_PROGRESS | COMPLETED |
  //           RECONCILED | WITHDRAWN | CANCELLED | EXPIRED
  priority                String    @default("NORMAL") // NORMAL | URGENT
  defaultModeOfMovement   String    @default("COMPANY_VEHICLE") // WALKING|PUBLIC_TRANSPORT|COMPANY_VEHICLE|PERSONAL_VEHICLE|RIDE_HAIL|MIXED
  late                    Boolean   @default(false)
  emergency               Boolean   @default(false)
  emergencyReason         String?
  // Decision audit
  submittedAt             DateTime?
  decisionAt              DateTime?
  decisionById            String?
  decisionNote            String?
  managerEndorsedAt       DateTime?
  managerEndorsedById     String?
  acknowledgedAt          DateTime?
  // Aggregates (computed at decision; refreshed on relevant events)
  totalEstDurationMin     Int?
  totalEstDistanceKm      Float?
  totalEstTrafficDelayMin Int?
  estimatedCostEtb        Float?
  // Adjusted flag — set when Coordinator edited any stop before approving.
  adjusted                Boolean   @default(false)
  // Phase-2 reserved nullable hooks (UI hidden in Phase 1).
  linkedObjectiveId       String?
  linkedKeyResultId       String?
  linkedInitiativeId      String?
  // Soft-delete
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  requester User  @relation("DtpRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DtpDecidedBy", fields: [decisionById], references: [id], onDelete: SetNull)

  stops  TripStop[]
  legs   TripLeg[]
  events DtpEvent[]

  @@unique([requesterId, tripDate]) // one plan per employee per date
  @@index([tripDate, status])
  @@index([departmentId, tripDate])
  @@index([status])
  @@map("dtp_plans")
}

/// One stop within a plan. `seq` orders the day; `dwellMinutes` drives the
/// dwell-aware optimizer; `tripMode` is per-stop because mixed days are common.
model TripStop {
  id                     String   @id @default(cuid())
  planId                 String
  seq                    Int
  // Purpose
  tripTypeId             String?
  purposeCode            String // mirrors TripType.code at submission for stable history
  // Destination
  destinationName        String
  destinationAddress     String
  destinationLat         Float?
  destinationLng         Float?
  destinationPlaceId     String?
  contactPerson          String?
  contactPhone           String?
  // Timing
  plannedStart           String // HH:MM (24h, local time)
  dwellMinutes           Int      @default(60)
  flexibility            String   @default("FIXED") // FIXED | FLEX_30 | FLEX_2H | ANY_TIME
  // Mode
  tripMode               String   @default("ROUND_TRIP") // ROUND_TRIP | ONE_WAY
  modeOfMovement         String? // overrides plan default if set
  pickupBackTo           String? // OFFICE | NEXT_STOP | CUSTOM (only meaningful for ROUND_TRIP)
  pickupBackAddress      String? // when pickupBackTo = CUSTOM
  pickupBackLat          Float?
  pickupBackLng          Float?
  // Logistics
  requiresVehicle        Boolean  @default(true)
  requiresCashAdvance    Boolean  @default(false)
  cashAdvanceAmount      Float?
  reason                 String // free text — what the trip is for
  expectedOutcome        String?
  withWhom               String   @default("") // CSV of user.id joiners
  // Traffic snapshot — JSON: { baselineMin, withTrafficMin, departureTime, model }
  trafficEstimate        String?
  // Coordinator adjustment diff — JSON of {field: {before, after}}
  coordinatorAdjustments String?
  // Original snapshot before Coordinator edits (set on first edit, cleared on requester re-edit)
  originalSnapshot       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  plan     DailyTripPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tripType DtpTripType?  @relation(fields: [tripTypeId], references: [id], onDelete: SetNull)
  legs     TripLeg[]

  @@unique([planId, seq])
  @@index([planId])
  @@map("dtp_trip_stops")
}

/// Driver-level work unit generated from approved stops.
/// Two leg types: DROPOFF (always for vehicle-required stops) and RETURN_PICKUP
/// (only for ROUND_TRIP stops).
model TripLeg {
  id                  String    @id @default(cuid())
  planId              String
  tripStopId          String
  runSheetId          String?
  legType             String // DROPOFF | RETURN_PICKUP
  fromLabel           String
  fromLat             Float?
  fromLng             Float?
  toLabel             String
  toLat               Float?
  toLng               Float?
  scheduledTime       String // HH:MM
  estimatedTrafficMin Int?
  passengerIds        String    @default("") // CSV of user.id passengers
  vehicleId           String?
  driverId            String?
  status              String    @default("SCHEDULED") // SCHEDULED | EN_ROUTE | COMPLETED | SKIPPED
  actualTime          DateTime?
  actualLat           Float?
  actualLng           Float?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  plan     DailyTripPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tripStop TripStop       @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  runSheet DailyRunSheet? @relation(fields: [runSheetId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver   Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([runSheetId, scheduledTime])
  @@index([driverId, scheduledTime])
  @@index([tripStopId])
  @@map("dtp_trip_legs")
}

/// Daily Run Sheet — driver × date container. Created on driver assignment.
/// Legs reference this directly via runSheetId. Movement Sheets are derived
/// directly from plans + stops (no separate model needed).
model DailyRunSheet {
  id        String    @id @default(cuid())
  driverId  String
  vehicleId String?
  runDate   DateTime
  status    String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  driver  Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  legs    TripLeg[]

  @@unique([driverId, runDate])
  @@index([runDate])
  @@map("dtp_run_sheets")
}

/// Append-only audit trail for DTP. One row per state transition or material
/// edit. `payload` is JSON capturing the before/after diff for inspection.
model DtpEvent {
  id         String   @id @default(cuid())
  planId     String
  actorId    String?
  action     String // SUBMIT | ENDORSE | RETURN | ADJUST | APPROVE | REJECT | ACK | CANCEL | WITHDRAW | ASSIGN_DRIVER | LEG_STATUS | EDIT | CLONE
  fromStatus String?
  toStatus   String?
  payload    String? // JSON
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  plan  DailyTripPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actor User?         @relation("DtpEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([action, createdAt])
  @@map("dtp_events")
}

/// Carpool / co-location cluster suggestion produced by the optimizer. Phase-1
/// optimizer is a stub — schema is here so accepted/rejected suggestions are
/// auditable when the real optimizer ships.
model RouteGroup {
  id            String    @id @default(cuid())
  runDate       DateTime
  departmentId  String?
  tripStopIds   String // CSV of trip_stop.id members
  centerLat     Float?
  centerLng     Float?
  radiusM       Int?
  estSavingsKm  Float?
  estSavingsMin Int?
  estSavingsEtb Float?
  status        String    @default("SUGGESTED") // SUGGESTED | ACCEPTED | REJECTED
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([runDate])
  @@map("dtp_route_groups")
}

// ──────────────────────────────────────────────────────────────────────────
// Telegram bot integration (Stage 1: /ask Q&A + passive scraping)
// See docs/TELEGRAM_BOT.md
// ──────────────────────────────────────────────────────────────────────────

model TelegramChat {
  id            String   @id @default(cuid())
  chatId        BigInt   @unique
  type          String // private | group | supergroup | channel
  title         String?
  username      String?
  isActive      Boolean  @default(true)
  scrapeMode    String   @default("ALL") // ALL | MENTIONS_ONLY | OFF
  askEnabled    Boolean  @default(true)
  digestEnabled Boolean  @default(false)
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages TelegramMessage[]

  @@index([isActive])
  @@map("telegram_chats")
}

model TelegramMessage {
  id           String   @id @default(cuid())
  chatId       BigInt
  messageId    BigInt
  fromUserId   BigInt?
  fromUsername String?
  fromName     String?
  text         String?
  replyToId    BigInt?
  isCommand    Boolean  @default(false)
  command      String?
  rawJson      String
  sentAt       DateTime
  createdAt    DateTime @default(now())

  chat TelegramChat @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@unique([chatId, messageId])
  @@index([chatId, sentAt])
  @@index([command])
  @@map("telegram_messages")
}

model TelegramBotConfig {
  id           String    @id @default("default")
  botUsername  String?
  webhookUrl   String?
  webhookSetAt DateTime?
  systemPrompt String?
  updatedAt    DateTime  @updatedAt

  @@map("telegram_bot_config")
}

/// Letter Management — formal business correspondence (Cover, Offer, Guarantee letters).
/// See docs/letter_management_requirements.md.
model Letter {
  id                String    @id @default(cuid())
  referenceNumber   String?   @unique // 360G/LT/{CL|OF|GR}/{SEQ}/{YEAR} — null while DRAFT pre-save
  subject           String
  // Legacy single-string letter type (COVER/OFFER/GUARANTEE). Kept for
  // back-compat; the authoritative type for new letters is `letterTypeId`.
  letterType        String
  letterTypeId      String?
  status            String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | SENT | ARCHIVED
  date              DateTime  @default(now())
  // Customer — Odoo lookup or free-text fallback.
  odooPartnerId     String?
  customerName      String
  recipientAddress  String?
  salutation        String?
  closing           String?
  senderDepartment  String?
  bodyContent       String?   @db.Text
  // The authoritative letter body as a .docx (OOXML) blob produced by SuperDoc.
  // `bodyContent` is kept as an HTML mirror (regenerated server-side via
  // mammoth.js) for placeholder resolution + PDF rendering, but once a letter
  // has been edited in SuperDoc the source of truth is `bodyDocx`.
  bodyDocx          Bytes?
  // Authors / signatory.
  preparedById      String
  signatoryId       String?
  signatoryTitle    String?   // Job title shown below signatory name on the letter (English)
  signatoryTitleAmharic String? // Job title in Amharic — used when lang=am
  // Dispatch (filled at Mark as Sent).
  dispatchMethod    String? // EMAIL | PRINTED | COURIER
  dispatchDate      DateTime?
  trackingReference String?
  // Soft state.
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  preparedBy    User              @relation("LetterPreparedBy", fields: [preparedById], references: [id])
  signatory     User?             @relation("LetterSignatory", fields: [signatoryId], references: [id], onDelete: SetNull)
  letterTypeDef LetterTypeDef?    @relation(fields: [letterTypeId], references: [id], onDelete: SetNull)
  enclosures    LetterEnclosure[]
  activityLog   ActivityLog[]

  @@index([status, date])
  @@index([letterType, date])
  @@index([letterTypeId])
  @@index([preparedById])
  @@index([signatoryId])
  @@map("letters")
}

model LetterEnclosure {
  id           String   @id @default(cuid())
  letterId     String
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String // mocked path; real impl would upload to object storage
  uploadedById String
  createdAt    DateTime @default(now())

  letter     Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("LetterEnclosureUploader", fields: [uploadedById], references: [id])

  @@index([letterId])
  @@map("letter_enclosures")
}

/// Per-(type, year) monotonic sequence for letter reference numbers.
/// Concurrent-safe: rely on the unique constraint + interactive transaction increment.
model LetterSequence {
  id        String   @id @default(cuid())
  typeCode  String // CL | OF | GR | custom user-defined codes
  year      Int
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([typeCode, year])
  @@map("letter_sequences")
}

/// User-defined letter types. Seeded with three built-ins (COVER, OFFER,
/// GUARANTEE) marked `isBuiltIn: true` — those cannot be deleted but custom
/// types created by users can. The `code` field is the 2-letter ref-number
/// prefix (e.g. "CL", "OF", "GR", "NC" for a custom "Notice" type).
model LetterTypeDef {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "CL", "OF", "GR", "NC"
  name        String   @unique // e.g. "Cover Letter"
  description String?
  isBuiltIn   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?    @relation("LetterTypeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  letters   Letter[]

  @@map("letter_types")
}

/// DB-driven letter permission matrix.
/// Stores whether a given system role has a given letter permission.
/// Seeded with defaults matching the original hardcoded rules in lib/permissions.ts.
/// Admins can edit rows at runtime via Settings > Letter Permissions.
model LetterRolePermission {
  id          String   @id @default(cuid())
  role        String   // ADMIN | EXECUTIVE | DEPARTMENT_LEAD | EMPLOYEE
  permission  String   // LetterPermission value (e.g. "letter.read")
  granted     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("LetterRolePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([role, permission])
  @@index([role])
  @@map("letter_role_permissions")
}

/// Per-user letter permission overrides.
/// A row with granted=true adds a permission the user's role doesn't have.
/// A row with granted=false revokes a permission the user's role does have.
model LetterUserPermission {
  id          String   @id @default(cuid())
  userId      String
  permission  String   // LetterPermission value
  granted     Boolean  // true = grant extra, false = revoke
  updatedById String?
  updatedAt   DateTime @updatedAt

  user      User  @relation("LetterUserPermissionTarget", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("LetterUserPermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@index([userId])
  @@map("letter_user_permissions")
}

model Role {
  id             String   @id @default(cuid())
  name           String   @unique
  key            String   @unique
  description    String?
  color          String?
  isSystem       Boolean  @default(false)
  hierarchyLevel Int?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userRoles              UserRole[]
  roleProfileMemberships RoleProfileMembership[]
  doctypePermissions     RoleDocTypePermission[]
  featurePermissions     FeaturePermission[]
  fieldPermissions       RoleDocTypeFieldPermission[]
  @@map("roles")
}

model UserRole {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  grantedById String?
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  user        User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
  @@map("user_roles")
}

model RoleProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  memberships  RoleProfileMembership[]
  userProfiles UserRoleProfile[]
  @@map("role_profiles")
}

model RoleProfileMembership {
  id        String      @id @default(cuid())
  profileId String
  roleId    String
  profile   RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([profileId, roleId])
  @@map("role_profile_memberships")
}

model UserRoleProfile {
  id          String      @id @default(cuid())
  userId      String
  profileId   String
  grantedById String?
  grantedAt   DateTime    @default(now())
  user        User        @relation("UserRoleProfiles", fields: [userId], references: [id], onDelete: Cascade)
  profile     RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([userId, profileId])
  @@map("user_role_profiles")
}

model DocTypeRegistry {
  key           String  @id
  displayName   String
  module        String
  isSubmittable Boolean @default(false)
  description   String?
  fields       DocTypeFieldRegistry[]
  permissions  RoleDocTypePermission[]
  scopeRules   RecordScopeRule[]
  @@map("doctype_registry")
}

model DocTypeFieldRegistry {
  id           String  @id @default(cuid())
  doctypeKey   String
  fieldName    String
  displayLabel String
  permLevel    Int     @default(0)
  isSensitive  Boolean @default(false)
  doctype      DocTypeRegistry @relation(fields: [doctypeKey], references: [key], onDelete: Cascade)
  @@unique([doctypeKey, fieldName])
  @@map("doctype_field_registry")
}

model RoleDocTypePermission {
  id           String  @id @default(cuid())
  roleId       String
  doctypeKey   String
  permLevel    Int     @default(0)
  canRead      Boolean @default(false)
  canWrite     Boolean @default(false)
  canCreate    Boolean @default(false)
  canDelete    Boolean @default(false)
  canSubmit    Boolean @default(false)
  canExport    Boolean @default(false)
  canPrint     Boolean @default(false)
  canShare     Boolean @default(false)
  canImport    Boolean @default(false)
  canReport    Boolean @default(false)
  applyScoping Boolean @default(false)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  doctype      DocTypeRegistry @relation(fields: [doctypeKey], references: [key], onDelete: Cascade)
  updatedAt    DateTime        @updatedAt
  updatedById  String?
  @@unique([roleId, doctypeKey, permLevel])
  @@map("role_doctype_permissions")
}

model RecordScopeRule {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  doctypeKey  String
  fieldName   String
  operator    String
  valueType   String
  staticValue String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  doctype     DocTypeRegistry @relation(fields: [doctypeKey], references: [key], onDelete: Cascade)
  @@map("record_scope_rules")
}

model FeaturePermission {
  id          String   @id @default(cuid())
  roleId      String
  featureKey  String
  visible     Boolean  @default(true)
  enabled     Boolean  @default(true)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  updatedById String?
  @@unique([roleId, featureKey])
  @@map("feature_permissions")
}

model UserPermissionOverride {
  id           String    @id @default(cuid())
  userId       String
  doctypeKey   String?
  featureKey   String?
  action       String?
  overrideType String
  reason       String
  grantedById  String
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime?
  user         User      @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_permission_overrides")
}

// ---------------------------------------------------------------------------
// Performance & Scorecard Evaluation
// ---------------------------------------------------------------------------

/// Singleton configuration for performance scoring, calibration, and nudges.
model PerformanceSettings {
  id                       String   @id @default("singleton")
  varianceThreshold        Float    @default(3)
  improvementFocusLimit    Int      @default(2)
  remarkAttributionEnabled Boolean  @default(false)
  weeklyNudgeDay           Int      @default(1) // ISO weekday: Monday = 1
  recommendationRulesJson  Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("performance_settings")
}

/// Stable identity for a role scorecard across immutable published versions.
model ScorecardTemplateFamily {
  id          String   @id @default(cuid())
  name        String   @unique
  roleLabel   String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates           ScorecardTemplate[]
  roleMappings        TemplateRoleMapping[]
  employeeAssignments EmployeeTemplateAssignment[]

  @@map("scorecard_template_families")
}

/// One immutable published scorecard definition. Published versions are forked,
/// never edited in place.
model ScorecardTemplate {
  id             String    @id @default(cuid())
  familyId       String
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  maxTotal       Float     @default(0)
  gatekeeperJson Json
  bandsJson      Json
  createdById    String
  forkedFromId   String?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family     ScorecardTemplateFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  forkedFrom ScorecardTemplate?       @relation("ScorecardTemplateForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      ScorecardTemplate[]      @relation("ScorecardTemplateForks")
  tiers      ScorecardTier[]
  evaluations Evaluation[]

  @@unique([familyId, version])
  @@index([familyId, status])
  @@map("scorecard_templates")
}

model ScorecardTier {
  id        String @id @default(cuid())
  templateId String
  name      String
  position  Int
  maxPoints Float

  template  ScorecardTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria  ScorecardCriterion[]

  @@unique([templateId, position])
  @@map("scorecard_tiers")
}

model ScorecardCriterion {
  id              String  @id @default(cuid())
  tierId          String
  libraryEntryId  String?
  type            String // RUBRIC | METRIC
  code            String?
  title           String
  position        Int
  maxPoints       Float   @default(10)
  weight          Float   @default(1)
  anchorJson      Json?
  unit            String?
  periodLabel     String?
  target          Float?
  scoringRuleJson Json?
  krAggregation   String? // SUM | AVG | LATEST

  tier          ScorecardTier         @relation(fields: [tierId], references: [id], onDelete: Cascade)
  libraryEntry  CriterionLibraryEntry? @relation(fields: [libraryEntryId], references: [id], onDelete: SetNull)
  metricMappings MetricSourceMapping[]
  metricSources  EvaluationMetricSource[]
  evaluatorScores EvaluatorScore[]
  results         CriterionResult[]
  improvementFocuses ImprovementFocus[]

  @@unique([tierId, position])
  @@index([libraryEntryId])
  @@map("scorecard_criteria")
}

/// Versioned source library. Content is copied into a template criterion.
model CriterionLibraryEntry {
  id             String   @id @default(cuid())
  code           String
  name           String
  version        Int      @default(1)
  type           String
  definitionJson Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  criteria ScorecardCriterion[]

  @@unique([code, version])
  @@map("criterion_library_entries")
}

/// Resolves a user's normalized designation and optional department to a
/// scorecard family.
model TemplateRoleMapping {
  id             String  @id @default(cuid())
  designationKey String
  departmentId   String?
  familyId       String
  priority       Int     @default(0)
  isActive       Boolean @default(true)

  department Department?              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  family     ScorecardTemplateFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([designationKey, departmentId, familyId])
  @@index([designationKey, isActive])
  @@map("performance_template_role_mappings")
}

/// Explicit employee-level scorecard family override.
model EmployeeTemplateAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  familyId      String
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  assignedById  String
  createdAt     DateTime  @default(now())

  employee User                    @relation("PerformanceTemplateEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  family   ScorecardTemplateFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom, effectiveTo])
  @@map("performance_employee_template_assignments")
}

/// Employee-specific Key Result source for a reusable metric criterion.
model MetricSourceMapping {
  id             String   @id @default(cuid())
  criterionId    String
  employeeId     String
  sourceType     String   @default("KEY_RESULT") // KEY_RESULT | SCRUM
  keyResultId    String?
  scrumMetricKey String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  criterion ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  employee  User               @relation("PerformanceMetricEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  keyResult KeyResult?         @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@unique([criterionId, employeeId, keyResultId])
  @@unique([criterionId, employeeId, scrumMetricKey])
  @@index([employeeId, criterionId])
  @@index([sourceType, scrumMetricKey])
  @@map("performance_metric_source_mappings")
}

model ReviewCycle {
  id                  String    @id @default(cuid())
  name                String
  cadence             String // MONTHLY | EVERY_TWO_MONTHS | QUARTERLY
  periodStart         DateTime
  periodEnd           DateTime
  status              String    @default("PLANNED") // PLANNED | OPEN | CONSOLIDATING | CLOSED
  allCompany          Boolean   @default(true)
  createdById         String
  openedAt            DateTime?
  closedAt            DateTime?
  closedById          String?
  closeOverrideReason String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  departments ReviewCycleDepartment[]
  issues      ReviewCycleIssue[]
  evaluations Evaluation[]

  @@index([status, periodStart])
  @@map("performance_review_cycles")
}

model ReviewCycleDepartment {
  cycleId      String
  departmentId String

  cycle      ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([cycleId, departmentId])
  @@map("performance_review_cycle_departments")
}

model ReviewCycleIssue {
  id           String    @id @default(cuid())
  cycleId      String
  employeeId   String?
  evaluationId String?
  type         String // NO_TEMPLATE | NO_LEAD | AMBIGUOUS_LEAD | METRIC_SOURCE_MISSING | ACTUAL_UNAVAILABLE
  detailJson   Json?
  status       String    @default("OPEN") // OPEN | RESOLVED | WAIVED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  cycle      ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([cycleId, status])
  @@index([employeeId])
  @@map("performance_review_cycle_issues")
}

model Evaluation {
  id               String    @id @default(cuid())
  cycleId          String
  templateId       String
  employeeId       String
  status           String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | CONSOLIDATED | CALIBRATION | DRAFT_SHARED | FINALIZED | EXCUSED
  maxTotal         Float
  rawTotal         Float?
  normalized       Float?
  gatekeeperPass   Boolean?
  decisionBand     String?
  startedAt        DateTime?
  consolidatedAt   DateTime?
  draftSharedAt    DateTime?
  finalizedAt      DateTime?
  excusedAt        DateTime?
  excusedReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cycle        ReviewCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  template     ScorecardTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employee     User              @relation("PerformanceEvaluationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  metricSources EvaluationMetricSource[]
  assignments   EvaluatorAssignment[]
  scores        EvaluatorScore[]
  results       CriterionResult[]
  reports       EvaluationReport[]
  acknowledgements EvaluationAcknowledgement[]
  improvementFocuses ImprovementFocus[]
  developmentActions DevelopmentAction[]
  issues        ReviewCycleIssue[]
  activityLogs  ActivityLog[]

  @@unique([cycleId, employeeId])
  @@index([employeeId, status])
  @@index([cycleId, status])
  @@map("performance_evaluations")
}

/// Frozen Key Result source link for one evaluation and criterion.
model EvaluationMetricSource {
  id                       String @id @default(cuid())
  evaluationId             String
  criterionId              String
  sourceType               String @default("KEY_RESULT") // KEY_RESULT | SCRUM
  keyResultId              String?
  keyResultTitleSnapshot   String?
  scrumMetricKey           String?
  scrumMetricLabelSnapshot String?
  position                 Int    @default(0)

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  keyResult  KeyResult?         @relation(fields: [keyResultId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId, keyResultId], map: "perf_eval_metric_source_kr_unique")
  @@unique([evaluationId, criterionId, scrumMetricKey], map: "perf_eval_metric_source_scrum_unique")
  @@map("performance_evaluation_metric_sources")
}

model EvaluatorAssignment {
  id           String    @id @default(cuid())
  evaluationId String
  evaluatorId  String
  role         String    @default("EVALUATOR") // LEAD | EVALUATOR
  status       String    @default("PENDING") // PENDING | SUBMITTED
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluator  User       @relation("PerformanceEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, evaluatorId])
  @@index([evaluatorId, status])
  @@map("performance_evaluator_assignments")
}

model EvaluatorScore {
  id           String    @id @default(cuid())
  evaluationId String
  evaluatorId  String
  criterionId  String
  score        Float
  remark       String?
  isAutoPulled Boolean   @default(false)
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluator  User               @relation("PerformanceScoreEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  criterion  ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, evaluatorId, criterionId])
  @@index([evaluationId, criterionId])
  @@map("performance_evaluator_scores")
}

model CriterionResult {
  id              String    @id @default(cuid())
  evaluationId    String
  criterionId     String
  consolidated    Float
  variance        Float     @default(0)
  flagged         Boolean   @default(false)
  actualValue     Float?
  actualSourceJson Json?
  calibrationNote String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId, flagged])
  @@map("performance_criterion_results")
}

/// Immutable employee-facing report snapshot. Disputes can create a new version.
model EvaluationReport {
  id           String    @id @default(cuid())
  evaluationId String
  version      Int       @default(1)
  status       String    @default("DRAFT") // DRAFT | SHARED | FINAL
  contentJson  Json
  generatedAt  DateTime  @default(now())
  sharedAt     DateTime?
  finalizedAt  DateTime?

  evaluation       Evaluation                  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  acknowledgements EvaluationAcknowledgement[]

  @@unique([evaluationId, version])
  @@map("performance_evaluation_reports")
}

model EvaluationAcknowledgement {
  id             String    @id @default(cuid())
  evaluationId   String
  reportId       String
  status         String    @default("PENDING") // PENDING | ACKNOWLEDGED | DISPUTED
  comment        String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  evaluation Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  report     EvaluationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId])
  @@index([evaluationId])
  @@map("performance_evaluation_acknowledgements")
}

model ImprovementFocus {
  id           String   @id @default(cuid())
  evaluationId String
  employeeId   String
  criterionId  String
  currentLevel Float
  targetText   String
  status       String   @default("ACTIVE") // ACTIVE | IMPROVED | DROPPED
  weeklyStep   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  employee   User               @relation("PerformanceFocusEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  criterion  ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([employeeId, status])
  @@map("performance_improvement_focuses")
}

model PerformanceNudgeDelivery {
  id          String   @id @default(cuid())
  employeeId  String
  weekKey     String // ISO week, e.g. 2026-W23
  focusCount  Int
  deliveredAt DateTime @default(now())

  @@unique([employeeId, weekKey])
  @@map("performance_nudge_deliveries")
}

model DevelopmentAction {
  id             String    @id @default(cuid())
  evaluationId   String
  type           String // SALARY_ADJUSTMENT | BONUS | PROMOTION | TRAINING | ROLE_CHANGE
  detailJson     Json
  recommendedBy  String
  status         String    @default("RECOMMENDED") // RECOMMENDED | APPROVED | REJECTED | EXECUTED
  decisionReason String?
  approvedById   String?
  executedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@map("performance_development_actions")
}

/// Per-role, per-doctype, per-field explicit read/write permission.
/// Overrides the coarse permLevel filter with fine-grained canRead/canWrite flags.
/// Missing rows mean "no per-field override" — fall back to permLevel logic.
model RoleDocTypeFieldPermission {
  id         String  @id @default(cuid())
  roleId     String
  doctypeKey String
  fieldName  String
  canRead    Boolean @default(true)
  canWrite   Boolean @default(false)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, doctypeKey, fieldName])
  @@map("role_doctype_field_permissions")
}

// =============================================================================
// PROJECT MANAGEMENT & DELIVERY INTELLIGENCE MODULE
// Build spec: docs/project_management_module_BUILD_SPEC.md (Part 3 — Data Model)
// Conventions: enums stored as String; userId references are plain-string FKs
// (no formal Prisma relation) to avoid User back-relation explosion — matching
// the build spec. Formal relations only for intra-module links + Project->
// Objective and Milestone->KeyResult (OKR integration, Epic K).
// =============================================================================

// --- 3.1 Core Schedule --------------------------------------------------------

model Project {
  id                  String    @id @default(cuid())
  code                String    @unique // "PRJ-2026-014"
  name                String
  description         String?
  clientName          String
  clientId            String? // optional CRM link
  projectManagerId    String // plain FK -> User
  departmentId        String? // plain FK -> Department
  templateId          String? // FK -> ProjectTemplate

  // Dates
  plannedStart        DateTime
  plannedEnd          DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  // Baseline
  baselineCommittedAt DateTime? // NULL = not yet baselined
  baselineVersion     Int       @default(0)

  // Status & health
  status              String    @default("PLANNING") // PLANNING|ACTIVE|ON_HOLD|COMPLETED|CANCELLED
  ragStatus           String    @default("GREEN") // GREEN|AMBER|RED (computed)
  confidence          Int       @default(100) // 0-100
  percentComplete     Float     @default(0) // weighted rollup
  percentPlanned      Float     @default(0) // expected % as of today

  // EVM
  spi                 Float?
  cpi                 Float?
  eac                 Float?
  plannedValue        Float?
  earnedValue         Float?
  actualCost          Float?
  budgetAtCompletion  Float?

  // Contract
  contractValue       Float?
  currency            String    @default("ETB")

  // Jira (OPTIONAL)
  jiraLinked          Boolean   @default(false)
  jiraConnectionId    String?

  // Client portal
  portalEnabled       Boolean   @default(false)
  clientEmails        String[] // report distribution list

  // OKR link
  objectiveId         String?

  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  phases              Phase[]
  members             ProjectMember[]
  delayEvents         DelayEvent[]
  changeRequests      ChangeRequest[]
  raidItems           RaidItem[]
  stageGates          StageGate[]
  clientObligations   ClientObligation[]
  coeRecords          CorrectionOfError[]
  paymentMilestones   PaymentMilestone[]
  reports             ProjectReport[]
  scrumLogs           ScrumLog[]
  activityLogs        ActivityLog[]
  template            ProjectTemplate? @relation(fields: [templateId], references: [id])
  jiraConnection      JiraConnection?  @relation(fields: [jiraConnectionId], references: [id])
  objective           Objective?       @relation(fields: [objectiveId], references: [id])

  @@index([status, ragStatus])
  @@index([projectManagerId])
  @@map("projects")
}

model Phase {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  position        Int
  weight          Float    @default(0) // % contribution to project
  percentComplete Float    @default(0) // rollup from milestones
  status          String   @default("NOT_STARTED")

  plannedStart    DateTime?
  plannedEnd      DateTime?
  baselineStart   DateTime?
  baselineEnd     DateTime?
  currentStart    DateTime?
  currentEnd      DateTime?

  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones      Milestone[]
  stageGate       StageGate?

  @@index([projectId, position])
  @@map("project_phases")
}

model Milestone {
  id              String   @id @default(cuid())
  phaseId         String
  name            String
  position        Int
  weight          Float    @default(0)
  percentComplete Float    @default(0)
  status          String   @default("NOT_STARTED")
  isKeyMilestone  Boolean  @default(false) // shown as diamond on Gantt

  baselineDate    DateTime?
  currentDate     DateTime?

  // OKR link
  keyResultId     String?

  phase           Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  activities      Activity[]
  keyResult       KeyResult? @relation(fields: [keyResultId], references: [id])

  @@index([phaseId, position])
  @@map("project_milestones")
}

model Activity {
  id               String   @id @default(cuid())
  milestoneId      String
  parentActivityId String? // ONE level of subtasks (Instagantt parity)
  position         Int

  title            String
  description      String? // rich text

  // Ownership — critical for delay attribution & client anonymization
  assigneeId       String? // plain FK -> User. INTERNAL ONLY. Never sent to client.
  ownerParty       String   @default("360GROUND") // 360GROUND | CLIENT | SHARED

  // Baseline (frozen at commit — NEVER edited directly)
  baselineStart    DateTime?
  baselineEnd      DateTime?

  // Current (live, editable)
  currentStart     DateTime?
  currentEnd       DateTime?

  // Status enum: NOT_STARTED|STARTED|FINISHED|APPROVAL_REQUESTED|APPROVED|REJECTED
  status           String   @default("NOT_STARTED")

  percentComplete  Float    @default(0)
  weight           Float    @default(1)

  // Effort & cost
  estimatedHours   Float?
  actualHours      Float?
  estimatedCost    Float?
  actualCost       Float?

  priority         String? // LOW|MEDIUM|HIGH|CRITICAL
  risk             String? // LOW|MEDIUM|HIGH
  isBlocked        Boolean  @default(false)
  blockedSince     DateTime?

  isMilestone      Boolean  @default(false) // "Convert to Milestone"

  // Delay ledger
  waitingSince     DateTime? // set when status -> APPROVAL_REQUESTED
  slipDays         Int      @default(0) // computed: currentEnd - baselineEnd
  slipReason       String?
  slipOwner        String? // 360GROUND | CLIENT | SHARED

  // Custom bar color override (Activity Detail Panel)
  color            String?

  // Jira mapping
  jiraIssueKeys    String[]
  jiraAutoRollup   Boolean  @default(false)

  milestone        Milestone            @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  parent           Activity?            @relation("ActivitySubtasks", fields: [parentActivityId], references: [id])
  subtasks         Activity[]           @relation("ActivitySubtasks")
  predecessors     ActivityDependency[] @relation("Successor")
  successors       ActivityDependency[] @relation("Predecessor")
  comments         ActivityComment[]
  attachments      ActivityAttachment[]
  tags             ActivityTag[]
  delayEvents      DelayEvent[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([milestoneId, position])
  @@index([status])
  @@index([assigneeId])
  @@map("project_activities")
}

model ActivityDependency {
  id            String   @id @default(cuid())
  predecessorId String
  successorId   String
  type          String   @default("FS") // FS|SS|FF|SF
  lagDays       Int      @default(0)
  predecessor   Activity @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Activity @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("project_activity_dependencies")
}

model ActivityComment {
  id             String   @id @default(cuid())
  activityId     String
  authorId       String // plain FK -> User (or ClientPortalUser when isClientAuthor)
  content        String // HTML (WYSIWYG)
  parentId       String? // threaded
  visibility     String   @default("INTERNAL") // INTERNAL | CLIENT_VISIBLE
  mentions       String[] // userIds @mentioned
  isClientAuthor Boolean  @default(false)
  createdAt      DateTime @default(now())
  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("project_activity_comments")
}

model ActivityAttachment {
  id           String   @id @default(cuid())
  activityId   String
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String
  uploadedById String
  visibility   String   @default("INTERNAL") // INTERNAL | CLIENT_VISIBLE
  createdAt    DateTime @default(now())
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("project_activity_attachments")
}

model ActivityTag {
  id         String   @id @default(cuid())
  activityId String
  label      String
  color      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("project_activity_tags")
}

model ProjectMember {
  id            String  @id @default(cuid())
  projectId     String
  userId        String
  role          String // PM | DEVELOPER | QA | DESIGNER | BA | CLIENT_CONTACT
  allocationPct Float   @default(100)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// --- 3.2 Delay Ledger (Epic C) ------------------------------------------------

model DelayEvent {
  id             String    @id @default(cuid())
  projectId      String
  activityId     String?

  eventType      String // APPROVAL_WAIT | BASELINE_SLIP | BLOCKED
  daysLost       Float

  // Attribution
  owner          String // CLIENT | 360GROUND | SHARED
  reason         String // 9-value taxonomy (see build spec §C4)
  reasonDetail   String?
  phaseAtTime    String? // for Pareto analysis

  startedAt      DateTime
  endedAt        DateTime?
  isAutoDetected Boolean   @default(false) // true = approval clock, false = PM-tagged

  // Recovery plan (Delay Ledger T1)
  recoveryPlan   String?
  recoveryOwner  String?
  recoveryDate   DateTime?

  recordedById   String?
  createdAt      DateTime  @default(now())

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity       Activity? @relation(fields: [activityId], references: [id])

  @@index([projectId, owner])
  @@index([reason])
  @@map("project_delay_events")
}

model BaselineSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  version      Int
  reason       String // why re-baselined
  approvedById String
  snapshotJson Json // full schedule at time of baseline
  createdAt    DateTime @default(now())

  @@unique([projectId, version])
  @@map("project_baseline_snapshots")
}

// --- 3.3 Governance Registers (Epic H) ---------------------------------------

model RaidItem {
  id             String    @id @default(cuid())
  projectId      String
  type           String // RISK | ASSUMPTION | ISSUE | DEPENDENCY
  refCode        String // "R-001", "I-004"
  title          String
  description    String?
  category       String?

  // RISK-specific
  probability    Int? // 1-5
  impact         Int? // 1-5
  score          Int? // computed P x I
  mitigation     String?
  contingency    String?

  // ISSUE-specific
  severity       String? // LOW|MEDIUM|HIGH|CRITICAL
  resolution     String?
  daysOpen       Int? // computed

  // DEPENDENCY-specific
  dependsOnParty String? // CLIENT | 360GROUND | THIRD_PARTY
  neededByDate   DateTime?

  // ASSUMPTION-specific
  validated      Boolean?  @default(false)
  validatedAt    DateTime?
  impactIfFalse  String?

  ownerId        String?
  status         String    @default("OPEN") // OPEN|MITIGATING|CLOSED|REALISED
  clientVisible  Boolean   @default(false)
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, status])
  @@map("project_raid_items")
}

model ChangeRequest {
  id                  String    @id @default(cuid())
  projectId           String
  crCode              String // "CR-001"
  title               String
  description         String
  type                String // SCOPE_ADD | REQUIREMENT_CHANGE | DESCOPE
  requestedBy         String // free text
  requestedByParty    String // CLIENT | 360GROUND
  requestDate         DateTime

  scheduleImpactDays  Float     @default(0)
  costImpact          Float     @default(0)
  affectedActivityIds String[]

  status              String    @default("SUBMITTED") // SUBMITTED|UNDER_REVIEW|APPROVED|REJECTED|IMPLEMENTED
  ccbDecisionDate     DateTime?
  approvedById        String?
  clientSignOff       Boolean   @default(false)
  clientSignOffAt     DateTime?
  rejectionReason     String?

  createdAt           DateTime  @default(now())
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_change_requests")
}

model StageGate {
  id                   String    @id @default(cuid())
  projectId            String
  phaseId              String    @unique
  name                 String // "Requirements Gate"
  entryCriteria        String[]
  exitCriteria         String[]
  requiredDeliverables String[]
  requiredApprovals    String[]
  status               String    @default("NOT_REACHED") // NOT_REACHED|PENDING|PASSED|FAILED|WAIVED
  gateDate             DateTime?
  approvedById         String?
  waiverReason         String? // MANDATORY if WAIVED
  waivedById           String?
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase                Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@map("project_stage_gates")
}

model ClientObligation {
  id                String   @id @default(cuid())
  projectId         String
  obligation        String
  type              String // APPROVAL|AVAILABILITY|DATA|ACCESS|DECISION|ENVIRONMENT
  responsiblePerson String // named client-side person
  responsibleEmail  String?
  slaBusinessDays   Int
  isContractual     Boolean  @default(false)
  breachCount       Int      @default(0)
  complianceRate    Float? // computed %
  notes             String?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_client_obligations")
}

model ApprovalSlaBreach {
  id                String    @id @default(cuid())
  projectId         String
  activityId        String
  obligationId      String?
  sentForApprovalAt DateTime
  slaBusinessDays   Int
  approvedAt        DateTime?
  daysOverSla       Float
  clientApprover    String?
  createdAt         DateTime  @default(now())

  @@index([projectId])
  @@map("project_approval_sla_breaches")
}

model CorrectionOfError {
  id              String    @id @default(cuid())
  projectId       String
  coeCode         String // "COE-001"
  trigger         String // what slipped
  daysLost        Float
  costImpact      Float?
  timeline        String // factual sequence
  whys            Json // 5-Whys chain: [{why, answer}]
  rootCauseClass  String // PLANNING|REQUIREMENTS|APPROVAL|IMPLEMENTATION|ESTIMATION|EXTERNAL
  systemicFix     String // the mechanism that prevents recurrence
  fixOwnerId      String
  fixDueDate      DateTime
  fixStatus       String    @default("OPEN") // OPEN|IN_PROGRESS|DONE
  fedIntoTemplate Boolean   @default(false)
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_correction_of_errors")
}

model PaymentMilestone {
  id                 String    @id @default(cuid())
  projectId          String
  name               String
  contractClause     String?
  triggerActivityId  String? // fires when this activity -> APPROVED
  amount             Float
  currency           String    @default("ETB")
  plannedInvoiceDate DateTime?
  actualInvoiceDate  DateTime?
  invoiceStatus      String    @default("PENDING") // PENDING|INVOICED|PAID|OVERDUE
  paymentStatus      String    @default("UNPAID")
  daysOutstanding    Int?
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_payment_milestones")
}

// --- 3.4 Jira Integration (Epic G) -------------------------------------------

model JiraConnection {
  id             String        @id @default(cuid())
  name           String
  siteUrl        String // https://xxx.atlassian.net
  authType       String        @default("API_TOKEN") // API_TOKEN | OAUTH2
  email          String? // for API_TOKEN
  encryptedToken String // AES-256 encrypted at rest
  projectKey     String // Jira project key e.g. "MEDA"
  isActive       Boolean       @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String? // SUCCESS|PARTIAL|FAILED
  createdById    String
  createdAt      DateTime      @default(now())
  projects       Project[]
  syncLogs       JiraSyncLog[]
  issues         JiraIssue[]
  sprints        JiraSprint[]

  @@map("project_jira_connections")
}

model JiraIssue {
  id                      String           @id @default(cuid())
  connectionId            String
  jiraKey                 String // "MEDA-142"
  jiraId                  String
  summary                 String
  issueType               String // Bug|Story|Task|Epic|Sub-task
  status                  String
  statusCategory          String // TODO|IN_PROGRESS|DONE
  assigneeEmail           String?
  assigneeUserId          String? // resolved -> platform User
  epicKey                 String?
  sprintId                String?
  storyPoints             Float?
  originalEstimateSeconds Int?
  timeSpentSeconds        Int?
  labels                  String[]
  components              String[]
  jiraCreatedAt           DateTime
  jiraUpdatedAt           DateTime
  resolvedAt              DateTime?
  isBlocked               Boolean          @default(false)
  blockedSince            DateTime?
  lastActivityAt          DateTime? // for IDLE detection
  connection              JiraConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  worklogs                JiraWorklog[]
  transitions             JiraTransition[]

  @@unique([connectionId, jiraKey])
  @@index([assigneeUserId])
  @@index([sprintId])
  @@map("project_jira_issues")
}

model JiraSprint {
  id              String         @id @default(cuid())
  connectionId    String
  jiraSprintId    String
  name            String
  state           String // future|active|closed
  startDate       DateTime?
  endDate         DateTime?
  completeDate    DateTime?
  committedPoints Float?
  completedPoints Float?
  connection      JiraConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, jiraSprintId])
  @@map("project_jira_sprints")
}

model JiraWorklog {
  id               String    @id @default(cuid())
  issueId          String
  authorEmail      String
  authorUserId     String?
  timeSpentSeconds Int
  startedAt        DateTime
  issue            JiraIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([authorUserId, startedAt])
  @@map("project_jira_worklogs")
}

model JiraTransition {
  id             String    @id @default(cuid())
  issueId        String
  fromStatus     String?
  toStatus       String
  transitionedAt DateTime
  authorEmail    String?
  issue          JiraIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, transitionedAt])
  @@map("project_jira_transitions")
}

model JiraSyncLog {
  id             String         @id @default(cuid())
  connectionId   String
  trigger        String // CRON|MANUAL|WEBHOOK
  status         String // SUCCESS|PARTIAL|FAILED
  issuesPulled   Int            @default(0)
  sprintsPulled  Int            @default(0)
  worklogsPulled Int            @default(0)
  errors         String?
  durationMs     Int
  createdAt      DateTime       @default(now())
  connection     JiraConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("project_jira_sync_logs")
}

// --- 3.5 Templates, Scrum, Reports, Portal -----------------------------------

model ProjectTemplate {
  id            String    @id @default(cuid())
  name          String // "Standard Software Delivery"
  description   String?
  version       Int       @default(1)
  isSystem      Boolean   @default(false)
  structureJson Json // phases -> milestones -> activities
  createdById   String
  createdAt     DateTime  @default(now())
  projects      Project[]

  @@map("project_templates")
}

model ScrumLog {
  id             String   @id @default(cuid())
  projectId      String
  scrumDate      DateTime
  timeHeld       String // "09:15"
  durationMin    Int
  facilitatorId  String
  attendeeIds    String[]
  absenteeIds    String[]
  lateIds        String[]
  blockersRaised String?
  notes          String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scrumDate])
  @@map("project_scrum_logs")
}

// ===== DAILY SCRUM MODULE =====
// User references are plain string IDs by design; resolve names/avatars in services.

model ScrumUpdate {
  id                  String    @id @default(cuid())
  userId              String
  submittedById       String
  managerId           String?
  teamId              String?
  projectId           String?
  projectActivityId   String?
  scrumDate           DateTime  @db.Date
  status              String    @default("SUBMITTED") // DRAFT | SUBMITTED | CONFIRMED | AMENDED

  yesterdayDone       String?   @map("yesterdayPlan")
  yesterdayStatusJson Json?
  todayPlan           String
  blockers            String?
  blockerCategory     String? // EXTERNAL_DEPENDENCY | CLIENT_APPROVAL | INTERNAL_DEPENDENCY | TECHNICAL | ENVIRONMENT_ACCESS | UNCLEAR_REQUIREMENTS | RESOURCE_CAPACITY | TOOLING | OTHER
  blockerStatus       String?   @default("OPEN") // OPEN | RECURRING | ESCALATED | RESOLVED
  blockerDaysOpen     Int       @default(0)
  blockerFirstRaisedAt DateTime?
  blockerResolvedAt   DateTime?
  blockerResolvedById String?
  blockerResolutionNote String? @map("blockerResolution")
  escalatedAt         DateTime?
  escalatedToUserId   String?
  raidItemId          String?
  wins                String?   @map("win")
  mood                String? // GOOD | OKAY | STRUGGLING

  hasBlocker          Boolean   @default(false)
  hasWin              Boolean   @default(false)
  isLate              Boolean   @default(false)
  submittedAt         DateTime  @default(now())
  amendedAt           DateTime?
  confirmedAt         DateTime?

  isProxyEntry        Boolean   @default(false)
  proxyReason         String? // IN_CLIENT_MEETING | TRAVELLING | SICK | ON_LEAVE | NO_CONNECTIVITY | VERBAL_UPDATE_IN_STANDUP | OTHER
  proxyReasonDetail   String?
  proxyConfirmedByUser Boolean  @default(false)
  proxyConfirmedAt    DateTime?

  comments            ScrumComment[]
  links               ScrumUpdateLink[]
  celebrations        ScrumWinCelebration[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, scrumDate])
  @@index([scrumDate, teamId])
  @@index([projectId, scrumDate])
  @@index([projectActivityId, scrumDate])
  @@index([hasBlocker, scrumDate])
  @@index([hasWin, scrumDate])
  @@index([managerId, scrumDate])
  @@index([blockerStatus])
  @@index([raidItemId])
  @@index([submittedById, scrumDate])
  @@map("scrum_updates")
}

model ScrumComment {
  id          String      @id @default(cuid())
  updateId    String
  authorId    String
  body        String
  mentions    String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  update      ScrumUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId, createdAt])
  @@index([authorId, createdAt])
  @@map("scrum_comments")
}

model ScrumAbsence {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  type          String   @default("EXCUSED") // EXCUSED | PTO | SICK | TRAVEL | HOLIDAY | OTHER
  reason        String?
  recordedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([recordedById])
  @@map("scrum_absences")
}

model ScrumSettings {
  id                    String   @id @default("default")
  timezone              String   @default("Africa/Addis_Ababa")
  reminderTime          String   @default("08:00")
  cutoffTime            String   @default("08:30")
  absentTime            String   @default("09:00")
  managerDigestTime     String   @default("09:00")
  nudgeTime             String   @default("09:05")
  weeklyDigestDay       Int      @default(5)
  weeklyDigestTime      String   @default("16:00")
  workingDays           Int[]    @default([1, 2, 3, 4, 5])
  holidays              String[] @default([])
  moodEnabled           Boolean  @default(true)
  winsEnabled           Boolean  @default(true)
  proxyEntryEnabled     Boolean  @default(true) @map("proxyEnabled")
  telegramEnabled       Boolean  @default(false)
  requireTodoLink       Boolean  @default(false)
  recurringThresholdDays Int     @default(2)
  escalationThresholdDays Int    @default(3)
  blockerEscalationDays Int      @default(2)
  moodAlertDays         Int      @default(10)
  objectiveNeglectDays  Int      @default(14)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("scrum_settings")
}

model ScrumWinCelebration {
  id          String      @id @default(cuid())
  updateId    String
  userId      String
  createdAt   DateTime    @default(now())

  update      ScrumUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([userId, createdAt])
  @@map("scrum_win_celebrations")
}

model ScrumSavedView {
  id          String   @id @default(cuid())
  userId      String
  name        String
  filtersJson Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("scrum_saved_views")
}

model ScrumJobRun {
  id          String   @id @default(cuid())
  jobKey      String
  userId      String?
  runDate     DateTime @db.Date
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([jobKey, userId, runDate])
  @@index([jobKey, runDate])
  @@map("scrum_job_runs")
}

model ScrumUpdateLink {
  id             String       @id @default(cuid())
  updateId       String
  objectiveId    String?
  keyResultId    String?
  todoId         String?
  linkType       String // OBJECTIVE | KEY_RESULT | TODO — derived server-side
  context        String // TODAY | BLOCKER | WIN | YESTERDAY
  progressNote   String?
  createdById    String
  createdAt      DateTime     @default(now())

  update         ScrumUpdate  @relation(fields: [updateId], references: [id], onDelete: Cascade)
  objective      Objective?   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult      KeyResult?   @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  todo           Todo?        @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([updateId, objectiveId, context])
  @@unique([updateId, keyResultId, context])
  @@unique([updateId, todoId, context])
  @@index([objectiveId, createdAt])
  @@index([keyResultId, createdAt])
  @@index([todoId, createdAt])
  @@index([createdById, createdAt])
  @@map("scrum_update_links")
}

model ProjectReport {
  id              String    @id @default(cuid())
  projectId       String? // null = portfolio-level (WBR)
  type            String // CLIENT_BIMONTHLY|WBR|INDIVIDUAL|TEAM|SCRUM|STEERING|COE|PORTFOLIO|ESTIMATION|CAPACITY
  periodStart     DateTime
  periodEnd       DateTime
  status          String    @default("DRAFT") // DRAFT|PM_REVIEW|APPROVED|SENT
  aiSummary       String? // AI-generated, PM-EDITABLE
  aiSummaryEdited Boolean   @default(false)
  contentJson     Json // full report payload
  generatedAt     DateTime  @default(now())
  approvedById    String?
  approvedAt      DateTime?
  sentAt          DateTime?
  sentToEmails    String[]
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("project_reports")
}

model ClientPortalUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  clientName   String
  passwordHash String
  projectIds   String[] // HARD scope — only these projects
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@map("project_client_portal_users")
}
