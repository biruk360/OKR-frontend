// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production uses PostgreSQL (see env.example). `DATABASE_URL` is required.
  // Schema changes are applied via `prisma db push` from scripts/deploy.sh —
  // there is no migration history; `prisma/migrations/` is vestigial SQLite output.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums are represented as String for portability and simpler migrations

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  avatar    String?
  role      String   @default("EMPLOYEE") // ADMIN, EXECUTIVE, DEPARTMENT_LEAD, EMPLOYEE
  isActive  Boolean  @default(true)
  activationToken String?
  activationTokenExpires DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  ownedObjectives     Objective[]     @relation("ObjectiveOwner")
  ownedKeyResults     KeyResult[]     @relation("KeyResultOwner")
  assignedTodos       Todo[]          @relation("TodoAssignee")
  createdTodos        Todo[]          @relation("TodoCreator")
  keyResultCheckIns   KeyResultCheckIn[]
  comments            Comment[]
  notifications       Notification[]
  departmentMemberships DepartmentMembership[]
  managerRelationships ManagerRelationship[] @relation("Manager")
  directReports       ManagerRelationship[] @relation("DirectReport")
  clientErrorLogs     ClientErrorLog[]
  activityLogs        ActivityLog[]
  objectiveViews      ObjectiveView[]
  keyResultViews      KeyResultView[]
  ownedSprints        Sprint[]        @relation("SprintOwner")
  ownedSprintActivities SprintActivity[] @relation("SprintActivityOwner")
  sprintActivityComments SprintActivityComment[] @relation("SprintActivityCommentAuthor")
  assignedSprintActivityTasks SprintActivityTask[] @relation("SprintActivityTaskAssignee")
  emailDigestSent     EmailDigestState?

  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberships DepartmentMembership[]
  objectives  Objective[]

  @@map("departments")
}

model DepartmentMembership {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  role         String?    // e.g., "Lead", "Member"
  joinedAt     DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("department_memberships")
}

model ManagerRelationship {
  id            String   @id @default(cuid())
  managerId     String
  directReportId String
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  manager      User @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)
  directReport User @relation("DirectReport", fields: [directReportId], references: [id], onDelete: Cascade)

  @@unique([managerId, directReportId])
  @@map("manager_relationships")
}

model Timeframe {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Q1 2025", "H2 2025", "January 2025"
  type        String   @default("QUARTERLY") // MONTHLY, QUARTERLY, SIX_MONTH, YEARLY
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectives Objective[]

  @@map("timeframes")
}

model Objective {
  id          String           @id @default(cuid())
  title       String
  description String?
  level       String           // COMPANY, DEPARTMENT, INDIVIDUAL
  status      String           @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  goalStatus  String           @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, CLOSED
  progress    Float            @default(0) // Calculated from Key Results
  isPrivate   Boolean          @default(false) // Visibility: false = Public, true = Private
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  timeframeId String
  departmentId String?
  parentObjectiveId String?
  /// LOOSE = visual alignment only; STRICT_DEPENDENCY = progress can roll up from active child objectives
  alignmentType     String           @default("LOOSE")
  /// NONE | AVERAGE | SUM — used only when alignmentType is STRICT_DEPENDENCY and there are active children
  rollupCalculation String           @default("NONE")
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence    String           @default("WEEKLY")
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  owner            User         @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  timeframe        Timeframe    @relation(fields: [timeframeId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  parentObjective  Objective?   @relation("ObjectiveHierarchy", fields: [parentObjectiveId], references: [id])
  childObjectives  Objective[]  @relation("ObjectiveHierarchy")
  keyResults       KeyResult[]
  comments         Comment[]
  objectiveLabels  ObjectiveLabel[]
  activityLogs     ActivityLog[]
  views            ObjectiveView[]
  sprintActivities SprintActivity[]  @relation("SprintActivityObjective")
  todos            Todo[]            @relation("TodoObjective")

  @@map("objectives")
}

model KeyResult {
  id            String           @id @default(cuid())
  title         String
  description   String?
  startValue    Float            @default(0)
  targetValue   Float
  currentValue  Float            @default(0)
  unit          String           // e.g., "%", "users", "$"
  confidence    String           @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK
  progress      Float            @default(0) // Calculated from currentValue/targetValue
  status        String           @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  isPrivate     Boolean          @default(false) // Visibility: false = Public, true = Private
  ownerId       String
  objectiveId   String
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence String          @default("WEEKLY")
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  owner   User    @relation("KeyResultOwner", fields: [ownerId], references: [id])
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  todos    Todo[] // Renamed conceptually to "Initiative" in the UI; table is `initiatives`
  comments Comment[]
  checkIns KeyResultCheckIn[]
  activityLogs ActivityLog[]
  views    KeyResultView[]
  sprintActivities SprintActivity[]

  @@map("key_results")
}

model KeyResultCheckIn {
  id          String   @id @default(cuid())
  keyResultId String
  asOfDate    DateTime
  value       Float
  confidence  String
  analysis    String?
  createdById String
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([keyResultId, asOfDate])
  @@map("key_result_check_ins")
}

/// Initiative / To-do — actionable work item.
/// Can be standalone (personal to-do), linked to a Key Result, or linked to an
/// Objective. The Prisma model name stays `Todo` so existing code paths keep
/// working; the underlying table is `initiatives` and user-facing labels say
/// "To-do" on the dedicated page and "Initiative" when shown under a KR.
model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String
  creatorId   String
  /// Optional link to a Key Result — when set, the todo contributes toward KR work.
  keyResultId String?
  /// Optional link to an Objective — use when the work spans a whole objective
  /// rather than a single KR. Mutually informative with keyResultId; both can be set.
  objectiveId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  assignee  User       @relation("TodoAssignee", fields: [assigneeId], references: [id])
  creator   User       @relation("TodoCreator", fields: [creatorId], references: [id])
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  objective Objective? @relation("TodoObjective", fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([creatorId, status])
  @@map("initiatives")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorId    String
  objectiveId String?
  keyResultId String?
  parentId    String?  // For nested comments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  author     User       @relation(fields: [authorId], references: [id])
  objective  Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult  KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]  @relation("CommentReplies")

  @@map("comments")
}

model Notification {
  id        String           @id @default(cuid())
  type      String           // OBJECTIVE_CREATED, OBJECTIVE_UPDATED, etc.
  title     String
  message   String
  isRead    Boolean          @default(false)
  userId    String
  metadata  String?          // Additional data like objectiveId, keyResultId, etc. (JSON string)
  createdAt DateTime         @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Client-side crashes, unhandled rejections, and React error boundaries (troubleshooting).
model ClientErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  route     String?
  userAgent String?
  userId    String?
  digest    String?
  extra     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source])
  @@map("client_error_logs")
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3B82F6") // Default blue color
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectiveLabels ObjectiveLabel[]

  @@map("labels")
}

model ObjectiveLabel {
  id          String   @id @default(cuid())
  objectiveId String
  labelId     String
  createdAt   DateTime @default(now())

  // Relationships
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, labelId])
  @@map("objective_labels")
}

/// Activity log — append-only audit trail for objectives and key results.
/// One row per change. `action` is short ("CREATED", "UPDATED", "STATUS_CHANGED", "PROGRESS_UPDATED",
/// "ARCHIVED", "UNARCHIVED", "DELETED", "CHECKIN", "VIEWED", "COMMENTED", "INITIATIVE_ADDED", ...).
/// `changes` is a JSON string: `{ field: { from: any, to: any }, ... }`.
model ActivityLog {
  id           String   @id @default(cuid())
  entityType   String   // OBJECTIVE | KEY_RESULT
  objectiveId  String?
  keyResultId  String?
  action       String
  actorId      String?
  changes      String?  // JSON-encoded { field: { from, to } } map
  metadata     String?  // JSON-encoded extra context (e.g. ip, source page)
  createdAt    DateTime @default(now())

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@index([keyResultId, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

/// View tracking — capped to one row per (user, objective, day) by unique constraint
/// to keep storage bounded while still answering "who viewed and when".
model ObjectiveView {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  viewDate    String   // YYYY-MM-DD bucket — enables one-row-per-day uniqueness
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId, viewDate])
  @@index([objectiveId, lastViewAt])
  @@map("objective_views")
}

model KeyResultView {
  id          String   @id @default(cuid())
  keyResultId String
  userId      String
  viewDate    String
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, userId, viewDate])
  @@index([keyResultId, lastViewAt])
  @@map("key_result_views")
}

/// Sprint planning — Trello-style board for marketing/business teams.
/// Columns are dynamic per-sprint and become the activity status.
model Sprint {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User             @relation("SprintOwner", fields: [ownerId], references: [id])
  columns    SprintColumn[]
  activities SprintActivity[]

  @@index([ownerId, status])
  @@map("sprints")
}

model SprintColumn {
  id        String   @id @default(cuid())
  sprintId  String
  name      String
  position  Int      @default(0)
  color     String?  // optional accent color for the column header
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprint     Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  activities SprintActivity[]

  @@unique([sprintId, name])
  @@index([sprintId, position])
  @@map("sprint_columns")
}

model SprintActivity {
  id          String   @id @default(cuid())
  sprintId    String
  columnId    String
  title       String
  description String?
  ownerId     String
  /// Optional link to a Key Result — the activity contributes to this KR's work.
  keyResultId String?
  /// Optional link to an Objective (useful when the work spans a whole objective, not a single KR).
  objectiveId String?
  /// When set, points at the Initiative (Todo) row this activity was converted into.
  /// Lets the board show "converted" state and jump to the initiative record.
  convertedInitiativeId String?
  position    Int      @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprint    Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  column    SprintColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  owner     User          @relation("SprintActivityOwner", fields: [ownerId], references: [id])
  keyResult KeyResult?    @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  objective Objective?    @relation("SprintActivityObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  comments  SprintActivityComment[]
  tasks     SprintActivityTask[]

  @@index([sprintId, columnId, position])
  @@index([ownerId])
  @@map("sprint_activities")
}

/// Trello-style comment thread on a sprint activity.
model SprintActivityComment {
  id         String   @id @default(cuid())
  activityId String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User?          @relation("SprintActivityCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([activityId, createdAt])
  @@map("sprint_activity_comments")
}

/// Sub-task / checklist item on a sprint activity. Assignable to any user.
model SprintActivityTask {
  id          String   @id @default(cuid())
  activityId  String
  title       String
  status      String   @default("PENDING") // PENDING | COMPLETED
  assigneeId  String?
  position    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignee User?          @relation("SprintActivityTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([activityId, position])
  @@map("sprint_activity_tasks")
}

/// Tracks last sent weekly digest per user (idempotency for the Monday job).
model EmailDigestState {
  userId            String   @id
  lastSentAt        DateTime?
  lastDigestCadence String?  // "WEEKLY" — extensible
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_digest_state")
}

/// Outbound email queue — when SMTP isn't wired yet, every send lands here as a row
/// AND is mirrored to server logs. Once SMTP is configured, a worker can drain `status='PENDING'`.
model OutboundEmail {
  id          String   @id @default(cuid())
  toEmail     String
  toName      String?
  subject     String
  bodyText    String
  bodyHtml    String?
  template    String?  // identifier of the template that produced this row
  metadata    String?  // JSON context
  status      String   @default("PENDING") // PENDING | SENT | FAILED | LOGGED_ONLY
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@map("outbound_emails")
}
