// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production uses PostgreSQL (see env.example). `DATABASE_URL` is required.
  // Schema changes are applied via `prisma db push` from scripts/deploy.sh —
  // there is no migration history; `prisma/migrations/` is vestigial SQLite output.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums are represented as String for portability and simpler migrations

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  password               String?
  avatar                 String?
  role                   String    @default("EMPLOYEE") // ADMIN, EXECUTIVE, DEPARTMENT_LEAD, EMPLOYEE
  isActive               Boolean   @default(true)
  activationToken        String?
  activationTokenExpires DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relationships
  ownedObjectives             Objective[]              @relation("ObjectiveOwner")
  ownedKeyResults             KeyResult[]              @relation("KeyResultOwner")
  assignedTodos               Todo[]                   @relation("TodoAssignee")
  createdTodos                Todo[]                   @relation("TodoCreator")
  keyResultCheckIns           KeyResultCheckIn[]
  comments                    Comment[]
  notifications               Notification[]
  departmentMemberships       DepartmentMembership[]
  managerRelationships        ManagerRelationship[]    @relation("Manager")
  directReports               ManagerRelationship[]    @relation("DirectReport")
  clientErrorLogs             ClientErrorLog[]
  activityLogs                ActivityLog[]
  objectiveViews              ObjectiveView[]
  keyResultViews              KeyResultView[]
  objectiveContributions      ObjectiveContributor[]
  ownedSprints                Sprint[]                 @relation("SprintOwner")
  ownedSprintActivities       SprintActivity[]         @relation("SprintActivityOwner")
  sprintActivityComments      SprintActivityComment[]  @relation("SprintActivityCommentAuthor")
  assignedSprintActivityTasks SprintActivityTask[]     @relation("SprintActivityTaskAssignee")
  emailDigestSent             EmailDigestState?
  initiativeUpdates           InitiativeUpdate[]       @relation("InitiativeUpdateAuthor")
  userPreferences             UserPreference?
  notificationPrefs           NotificationPreference[]
  watchers                    Watcher[]
  favorites                   Favorite[]
  todoMembers                 TodoMember[]             @relation("TodoMemberUser")
  todoChecklistItems          TodoChecklistItem[]      @relation("TodoChecklistItemAssignee")
  todoAttachments             TodoAttachment[]         @relation("TodoAttachmentUploader")
  todoComments                TodoComment[]            @relation("TodoCommentAuthor")
  reportedRisks               Risk[]                   @relation("RiskReporter")
  sprintParticipations        SprintParticipant[]      @relation("SprintParticipantUser")
  sprintsEnded                Sprint[]                 @relation("SprintEndedBy")
  ceoOf                       OrganizationSettings?    @relation("OrgSettingsCeo")
  // Daily Trip Plan back-relations (see prisma/schema.prisma DTP block at the bottom).
  dtpRequestedPlans           DailyTripPlan[]          @relation("DtpRequester")
  dtpDecidedPlans             DailyTripPlan[]          @relation("DtpDecidedBy")
  dtpEvents                   DtpEvent[]               @relation("DtpEventActor")
  driverProfile               Driver?                  @relation("DriverUser")

  @@map("users")
}

/// User-starred OKRs surfaced under the "Watched" tab of the OKR Explorer.
/// Per-user, per-entity. Extend entityType to KEY_RESULT / TODO later.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String // "OBJECTIVE" for now
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@map("favorites")
}

/// Stores per-user UI preferences (sidebar vs modal for todo view, etc).
model UserPreference {
  userId       String   @id
  todoViewMode String   @default("modal") // "modal" | "sidebar"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberships DepartmentMembership[]
  objectives  Objective[]
  sprints     Sprint[]

  @@map("departments")
}

/// Membership of a user in a department.
/// `role` is one of HEAD | MEMBER | SECONDARY_MEMBER (string-stored enum).
/// `legacyRole` retains the pre-2026-05 free-text value for backfill auditing
/// and is dropped in a follow-up migration once `role` is fully populated.
/// `isPrimary` marks the user's primary department (exactly one active row per user).
/// `endedAt` enables soft-removal + history; null means active membership.
model DepartmentMembership {
  id           String    @id @default(cuid())
  userId       String
  departmentId String
  role         String    @default("MEMBER") // HEAD | MEMBER | SECONDARY_MEMBER
  legacyRole   String? // backfill-only; dropped after data migration
  isPrimary    Boolean   @default(true)
  joinedAt     DateTime  @default(now())
  endedAt      DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_memberships")
}

model ManagerRelationship {
  id             String    @id @default(cuid())
  managerId      String
  directReportId String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  manager      User @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)
  directReport User @relation("DirectReport", fields: [directReportId], references: [id], onDelete: Cascade)

  @@unique([managerId, directReportId])
  @@index([managerId])
  @@index([directReportId])
  @@map("manager_relationships")
}

/// Singleton row (id = "singleton") holding company-wide settings:
/// the CEO designation and feature flags for org structure.
model OrganizationSettings {
  id                      String   @id @default("singleton")
  companyName             String   @default("My Company")
  companyCeoUserId        String?  @unique
  allowMatrixReporting    Boolean  @default(false)
  allowMultipleDeptHeads  Boolean  @default(false)
  /// Master switch for the AI Sprint Planning feature (see docs/AI_SPRINT_PLANNING.md).
  /// When false, /api/sprints/ai/* routes return 404 and the "AI Plan" button is hidden.
  aiSprintPlanningEnabled Boolean  @default(false)
  /// Default AI provider when a /generate call doesn't specify one.
  /// One of "anthropic" | "openai" | "gemini".
  aiPreferredProvider     String   @default("anthropic")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ceo User? @relation("OrgSettingsCeo", fields: [companyCeoUserId], references: [id], onDelete: SetNull)

  @@map("organization_settings")
}

model Timeframe {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Q1 2025", "H2 2025", "January 2025"
  type      String   @default("QUARTERLY") // MONTHLY, QUARTERLY, SIX_MONTH, YEARLY
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  objectives Objective[]

  @@map("timeframes")
}

model Objective {
  id                String    @id @default(cuid())
  title             String
  description       String?
  level             String // COMPANY, DEPARTMENT, INDIVIDUAL
  status            String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  goalStatus        String    @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, CLOSED
  progress          Float     @default(0) // Calculated from Key Results
  // Owner-reported objective-level confidence (0-100). Read by Apple Pro hero/right-rail.
  // NOTE: requires `prisma db push` on deploy — preflight.sql already runs in CI.
  confidence        Int       @default(50)
  isPrivate         Boolean   @default(false) // Visibility: false = Public, true = Private
  startDate         DateTime?
  endDate           DateTime?
  ownerId           String
  timeframeId       String
  departmentId      String?
  parentObjectiveId String?
  /// LOOSE = visual alignment only; STRICT_DEPENDENCY = progress can roll up from active child objectives
  alignmentType     String    @default("LOOSE")
  /// NONE | AVERAGE | SUM — used only when alignmentType is STRICT_DEPENDENCY and there are active children
  rollupCalculation String    @default("NONE")
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence    String    @default("WEEKLY")
  /// Raw weight used when this objective contributes to a parent's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  /// Otherwise, the relative weight among siblings determines contribution %.
  weight            Float     @default(0)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  owner            User                   @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  timeframe        Timeframe              @relation(fields: [timeframeId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  parentObjective  Objective?             @relation("ObjectiveHierarchy", fields: [parentObjectiveId], references: [id])
  childObjectives  Objective[]            @relation("ObjectiveHierarchy")
  keyResults       KeyResult[]
  comments         Comment[]
  objectiveLabels  ObjectiveLabel[]
  activityLogs     ActivityLog[]
  views            ObjectiveView[]
  sprintActivities SprintActivity[]       @relation("SprintActivityObjective")
  todos            Todo[]                 @relation("TodoObjective")
  contributors     ObjectiveContributor[]
  risks            Risk[]

  @@index([departmentId])
  @@index([ownerId])
  @@map("objectives")
}

/// Additional people collaborating on an objective besides the sole owner.
/// Contributors can edit KRs and check in; they do NOT inherit admin rights.
model ObjectiveContributor {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  addedAt     DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId])
  @@index([userId])
  @@map("objective_contributors")
}

model KeyResult {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startValue     Float     @default(0)
  targetValue    Float
  currentValue   Float     @default(0)
  unit           String // e.g., "%", "users", "$"
  confidence     String    @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK
  progress       Float     @default(0) // Calculated from currentValue/targetValue
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  isPrivate      Boolean   @default(false) // Visibility: false = Public, true = Private
  ownerId        String
  objectiveId    String
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence String    @default("WEEKLY")
  /// Raw weight used when this KR contributes to its parent objective's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  weight         Float     @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  owner            User               @relation("KeyResultOwner", fields: [ownerId], references: [id])
  objective        Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  todos            Todo[] // Renamed conceptually to "Initiative" in the UI; table is `initiatives`
  comments         Comment[]
  checkIns         KeyResultCheckIn[]
  activityLogs     ActivityLog[]
  views            KeyResultView[]
  sprintActivities SprintActivity[]
  risks            Risk[]

  @@map("key_results")
}

model KeyResultCheckIn {
  id              String   @id @default(cuid())
  keyResultId     String
  asOfDate        DateTime
  value           Float
  /// Legacy enum-style tier kept for backward compatibility (ON_TRACK | AT_RISK | OFF_TRACK).
  /// New writes should also set `confidenceScore`; reads should prefer it.
  confidence      String
  /// Numeric 0-100 confidence captured from the Apple-style slider.
  /// Default 50 keeps existing rows valid until backfilled (see scripts/preflight.sql).
  confidenceScore Int      @default(50)
  analysis        String?
  createdById     String
  createdAt       DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([keyResultId, asOfDate])
  @@map("key_result_check_ins")
}

/// Initiative / To-do — actionable work item.
/// Can be standalone (personal to-do), linked to a Key Result, or linked to an
/// Objective. The Prisma model name stays `Todo` so existing code paths keep
/// working; the underlying table is `initiatives` and user-facing labels say
/// "To-do" on the dedicated page and "Initiative" when shown under a KR.
model Todo {
  id                    String    @id @default(cuid())
  title                 String
  description           String?
  status                String    @default("PENDING") // PENDING, IN_PROGRESS, IN_REVIEW, STUCK, COMPLETED, CANCELLED
  priority              String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  coverColor            String? // hex or named colour for the card cover strip
  startDate             DateTime?
  dueDate               DateTime?
  /// Wall-clock start/end time on the planner ("HH:mm"). Optional — todos
  /// without times render as all-day chips on the per-sprint Planner view.
  startTime             String?
  endTime               String?
  completedAt           DateTime?
  /// Optional primary assignee (legacy — Trello-style usage relies on TodoMember
  /// instead). Kept nullable for filters/notifications/legacy queries.
  assigneeId            String?
  creatorId             String
  /// Optional link to a Key Result — when set, the todo contributes toward KR work.
  keyResultId           String?
  /// Optional link to an Objective — use when the work spans a whole objective
  /// rather than a single KR. Mutually informative with keyResultId; both can be set.
  objectiveId           String?
  /// Numeric contribution in the parent KR's unit (ETB, pcs, qty, hours, %, …).
  /// When the initiative is marked COMPLETED, this value is summed into the
  /// parent KR's currentValue (see lib/objectiveProgress.ts → recalcKrFromInitiatives).
  progressValue         Float?
  /// Sprint v2 (Phase 1) — optional link to a Sprint. Allows todos to participate in
  /// the unified Sprint+Todo board planned for Phase 3. SetNull on sprint delete.
  sprintId              String?
  /// Card order within the sprint board lane. Higher = lower in list. Per-lane via (sprintId, status, sprintPosition).
  sprintPosition        Int       @default(0)
  /// Free-form task type tag (CALL, EMAIL, DEMO, MEETING, PROPOSAL, FOLLOW_UP, ADMIN, GENERAL).
  taskType              String?
  /// AI Sprint Planning (see docs/AI_SPRINT_PLANNING.md) — true when the row was
  /// generated by the AI sprint planner, false when manually created.
  aiSuggested           Boolean   @default(false)
  /// COMMITTED | STRETCH — set on AI-suggested rows so the user can drop stretch tasks.
  ambitionLevel         String?
  /// Sprint id where this todo was first created. Preserved across SPLIT carryovers
  /// so we can trace lineage back to the original sprint.
  originalSprintId      String?
  /// How many prior sprints this todo has been carried into. 0 for a fresh todo.
  /// >=2 disallows plain KEEP disposition — must be SPLIT/DESCOPE/ESCALATE.
  carryoverCount        Int       @default(0)
  /// When the row was last carried over to a new sprint.
  lastCarriedAt         DateTime?
  /// When SPLIT was applied, points at the cuid that groups the resulting child todos.
  carryoverReplacedById String?
  /// KEEP | SPLIT | RESCHEDULE | DESCOPE | ESCALATE — last carryover decision applied.
  /// Null on first creation.
  carryoverDisposition  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  assignee  User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  creator   User       @relation("TodoCreator", fields: [creatorId], references: [id])
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  objective Objective? @relation("TodoObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  initiativeUpdates InitiativeUpdate[]
  members           TodoMember[]
  labels            TodoLabel[]
  checklists        TodoChecklist[]
  attachments       TodoAttachment[]
  todoComments      TodoComment[]
  activityLogs      ActivityLog[]

  @@index([assigneeId, status])
  @@index([creatorId, status])
  @@index([sprintId])
  @@index([taskType])
  @@index([sprintId, status])
  @@index([sprintId, status, sprintPosition])
  @@index([originalSprintId])
  @@index([carryoverCount])
  @@map("initiatives")
}

/// Additional members on a todo (beyond the single primary assignee).
model TodoMember {
  id      String   @id @default(cuid())
  todoId  String
  userId  String
  addedAt DateTime @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation("TodoMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId])
  @@map("todo_members")
}

/// Coloured label attached to a todo. Label definitions live in TodoLabelDef.
model TodoLabel {
  id         String   @id @default(cuid())
  todoId     String
  labelDefId String
  createdAt  DateTime @default(now())

  todo     Todo         @relation(fields: [todoId], references: [id], onDelete: Cascade)
  labelDef TodoLabelDef @relation(fields: [labelDefId], references: [id], onDelete: Cascade)

  @@unique([todoId, labelDefId])
  @@map("todo_labels")
}

/// Board-wide label palette (name + color). Shared across all todos.
model TodoLabelDef {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366F1") // indigo default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoLabels TodoLabel[]

  @@map("todo_label_defs")
}

/// A named checklist group on a todo (a card can have multiple checklists).
model TodoChecklist {
  id        String   @id @default(cuid())
  todoId    String
  title     String   @default("Checklist")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo  Todo                @relation(fields: [todoId], references: [id], onDelete: Cascade)
  items TodoChecklistItem[]

  @@index([todoId, position])
  @@map("todo_checklists")
}

/// Individual item within a checklist.
model TodoChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completed   Boolean   @default(false)
  assigneeId  String?
  startDate   DateTime?
  dueDate     DateTime?
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist TodoChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TodoChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@map("todo_checklist_items")
}

/// File attachment on a todo. Stores the file URL (uploaded to storage) + metadata.
model TodoAttachment {
  id           String   @id @default(cuid())
  todoId       String
  uploadedById String
  filename     String
  url          String // storage URL (local path or CDN)
  mimeType     String
  size         Int // bytes
  createdAt    DateTime @default(now())

  todo       Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TodoAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@map("todo_attachments")
}

/// WYSIWYG comment thread on a todo. Separate from InitiativeUpdate (daily updates).
model TodoComment {
  id                 String   @id @default(cuid())
  todoId             String
  authorId           String
  content            String // HTML from Tiptap
  parentId           String? // for threaded replies
  /// JSON-encoded array of TodoAttachment ids that should render inline with this comment.
  /// Stored as a string (rather than relation) to avoid invasive M2M migration.
  commentAttachments String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  todo    Todo          @relation(fields: [todoId], references: [id], onDelete: Cascade)
  author  User          @relation("TodoCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  TodoComment?  @relation("TodoCommentReplies", fields: [parentId], references: [id])
  replies TodoComment[] @relation("TodoCommentReplies")

  @@index([todoId, createdAt])
  @@map("todo_comments")
}

/// Mandatory daily update on an initiative. One row per (initiative, date).
/// The report page renders a day-by-day grid from these rows.
model InitiativeUpdate {
  id           String   @id @default(cuid())
  initiativeId String
  authorId     String
  updateDate   String // YYYY-MM-DD bucket
  content      String
  status       String? // optional status snapshot at time of update
  blockers     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiative Todo @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  author     User @relation("InitiativeUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, updateDate])
  @@index([updateDate])
  @@index([authorId, updateDate])
  @@map("initiative_updates")
}

/// Bi-weekly auto-calculated confidence snapshot for an objective or key result.
/// Stored once per entity per calculation period so the system keeps a history
/// of confidence transitions over time.
model ConfidenceSnapshot {
  id           String   @id @default(cuid())
  entityType   String // OBJECTIVE | KEY_RESULT
  entityId     String
  periodStart  String // YYYY-MM-DD (the first day of the bi-weekly period)
  confidence   String // ON_TRACK | AT_RISK | OFF_TRACK
  score        Float // 0-100 computed score
  factors      String? // JSON: { progressPct, timeElapsedPct, velocity, ... }
  previousConf String? // previous confidence for delta detection
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, periodStart])
  @@index([entityType, periodStart])
  @@map("confidence_snapshots")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorId    String
  objectiveId String?
  keyResultId String?
  parentId    String? // For nested comments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  author    User       @relation(fields: [authorId], references: [id])
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]  @relation("CommentReplies")

  @@map("comments")
}

/// In-app notification row. One row per (user, event) recipient.
/// `eventKey` is the canonical event code from lib/notifications/events.ts (e.g. "KR_AT_RISK").
/// `category` buckets multiple events for preference toggling (see NotificationPreference).
/// Email-related columns track the companion OutboundEmail send (if any).
model Notification {
  id              String    @id @default(cuid())
  type            String // legacy OBJECTIVE_CREATED etc. — kept for backwards compat
  eventKey        String? // canonical event code (e.g. "KR_AT_RISK")
  category        String? // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  title           String
  message         String
  isRead          Boolean   @default(false)
  userId          String
  metadata        String? // JSON: { objectiveId?, keyResultId?, todoId?, actorId?, entityTitle?, redacted? }
  /// When true, the recipient should NOT see the entity title/values — dispatcher already
  /// wrote placeholder text into `title`/`message`, but downstream deep-link rendering
  /// should continue to respect isPrivate on the linked entity.
  redacted        Boolean   @default(false)
  /// Companion email delivery fields (null if no email was intended for this row).
  emailMode       String? // IMMEDIATE | DIGEST_DAILY | DIGEST_WEEKLY | DIGEST_MONTHLY | DISABLED
  emailSent       Boolean   @default(false)
  emailAt         DateTime?
  outboundEmailId String? // FK-ish pointer to OutboundEmail.id (no FK — OutboundEmail rows may be pruned)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([eventKey, createdAt])
  @@map("notifications")
}

/// Per-user notification preferences. One row per (user, category).
/// `inApp` / `email` toggle each channel. `emailCadence` controls batching for this category.
/// Missing rows fall back to the org defaults in OrgNotificationDefault.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  category     String // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE") // IMMEDIATE | DAILY | WEEKLY | DISABLED
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// Org-level notification defaults set by Admin in Settings. Applied when the user has no
/// explicit NotificationPreference row for a category. One row per category.
model OrgNotificationDefault {
  id           String   @id @default(cuid())
  category     String   @unique
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("org_notification_defaults")
}

/// Opt-in watchers on an entity (objective, KR, or todo). Watchers receive dispatcher events
/// matching their subscription. Use the composite key to scope.
model Watcher {
  id         String   @id @default(cuid())
  userId     String
  entityType String // OBJECTIVE | KEY_RESULT | TODO
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("watchers")
}

/// Pending email digest entries. The dispatcher writes here when a user's preference for
/// a category is DAILY/WEEKLY/MONTHLY instead of IMMEDIATE. The digest cron drains these
/// rows into bundled OutboundEmail rows.
model EmailDigestQueue {
  id       String    @id @default(cuid())
  userId   String
  cadence  String // DAILY | WEEKLY | MONTHLY
  category String
  eventKey String
  subject  String
  bodyText String
  bodyHtml String?
  metadata String? // JSON: { entityType, entityId, redacted, ... }
  queuedAt DateTime  @default(now())
  sentAt   DateTime?

  @@index([userId, cadence, sentAt])
  @@index([sentAt])
  @@map("email_digest_queue")
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Client-side crashes, unhandled rejections, and React error boundaries (troubleshooting).
model ClientErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  route     String?
  userAgent String?
  userId    String?
  digest    String?
  extra     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source])
  @@map("client_error_logs")
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3B82F6") // Default blue color
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectiveLabels ObjectiveLabel[]

  @@map("labels")
}

model ObjectiveLabel {
  id          String   @id @default(cuid())
  objectiveId String
  labelId     String
  createdAt   DateTime @default(now())

  // Relationships
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, labelId])
  @@map("objective_labels")
}

/// Activity log — append-only audit trail for objectives and key results.
/// One row per change. `action` is short ("CREATED", "UPDATED", "STATUS_CHANGED", "PROGRESS_UPDATED",
/// "ARCHIVED", "UNARCHIVED", "DELETED", "CHECKIN", "VIEWED", "COMMENTED", "INITIATIVE_ADDED", ...).
/// `changes` is a JSON string: `{ field: { from: any, to: any }, ... }`.
model ActivityLog {
  id          String   @id @default(cuid())
  entityType  String // OBJECTIVE | KEY_RESULT | TODO | SPRINT
  objectiveId String?
  keyResultId String?
  todoId      String?
  /// Sprint v2 (Phase 1) — optional sprint association for sprint lifecycle events.
  sprintId    String?
  action      String
  actorId     String?
  /// JSONB on Postgres — `{ field: { from, to } }`. Was `String` (JSON-encoded) before
  /// the 2026-04-14 migration; existing rows were converted with `changes::jsonb`.
  changes     Json?
  /// JSONB on Postgres — extra context (e.g. ip, source page, snippet).
  metadata    Json?
  createdAt   DateTime @default(now())

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  todo      Todo?      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@index([keyResultId, createdAt])
  @@index([todoId, createdAt])
  @@index([sprintId, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

/// View tracking — capped to one row per (user, objective, day) by unique constraint
/// to keep storage bounded while still answering "who viewed and when".
model ObjectiveView {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  viewDate    String // YYYY-MM-DD bucket — enables one-row-per-day uniqueness
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId, viewDate])
  @@index([objectiveId, lastViewAt])
  @@map("objective_views")
}

model KeyResultView {
  id          String   @id @default(cuid())
  keyResultId String
  userId      String
  viewDate    String
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, userId, viewDate])
  @@index([keyResultId, lastViewAt])
  @@map("key_result_views")
}

/// Sprint planning — Trello-style board for marketing/business teams.
/// Columns are dynamic per-sprint and become the activity status.
model Sprint {
  id             String    @id @default(cuid())
  name           String
  description    String?
  ownerId        String
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED — legacy, kept for backward compat
  // Sprint v2 (Phase 1) — additive lifecycle/state model.
  state          String    @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, CANCELLED
  goal           String?
  goalLabel      String?
  goalTarget     Float?
  goalCurrent    Float?    @default(0)
  goalUnit       String?
  /// Trello-style board background preset key (see lib/sprint-backgrounds.ts).
  /// "none" = neutral surface; otherwise one of the gradient preset keys.
  background     String?   @default("none")
  departmentId   String?
  reflectionNote String?
  endedAt        DateTime?
  endedById      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User                @relation("SprintOwner", fields: [ownerId], references: [id])
  columns      SprintColumn[]
  activities   SprintActivity[]
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  endedBy      User?               @relation("SprintEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  participants SprintParticipant[]
  todos        Todo[]
  activityLogs ActivityLog[]
  aiPlans      AiSprintPlan[]

  @@index([ownerId, status])
  @@index([state, endDate])
  @@index([departmentId])
  @@map("sprints")
}

/// Sprint v2 — explicit sprint membership. MEMBER for participants, OWNER mirrors creator.
model SprintParticipant {
  id       String   @id @default(cuid())
  sprintId String
  userId   String
  role     String   @default("MEMBER") // MEMBER, OWNER
  joinedAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation("SprintParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([userId])
  @@map("sprint_participants")
}

model SprintColumn {
  id        String   @id @default(cuid())
  sprintId  String
  name      String
  /// Global TodoStatus this lane represents (PENDING, IN_PROGRESS, IN_REVIEW, STUCK, COMPLETED).
  /// Each sprint has exactly one row per board status; lane order on the board is driven by `position`.
  statusKey String?
  position  Int      @default(0)
  color     String? // optional accent color for the column header
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprint     Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  activities SprintActivity[]

  @@unique([sprintId, name])
  @@unique([sprintId, statusKey])
  @@index([sprintId, position])
  @@map("sprint_columns")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
model SprintActivity {
  id                    String    @id @default(cuid())
  sprintId              String
  columnId              String
  title                 String
  description           String?
  ownerId               String
  /// Optional link to a Key Result — the activity contributes to this KR's work.
  keyResultId           String?
  /// Optional link to an Objective (useful when the work spans a whole objective, not a single KR).
  objectiveId           String?
  /// When set, points at the Initiative (Todo) row this activity was converted into.
  /// Lets the board show "converted" state and jump to the initiative record.
  convertedInitiativeId String?
  position              Int       @default(0)
  dueDate               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sprint    Sprint                  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  column    SprintColumn            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  owner     User                    @relation("SprintActivityOwner", fields: [ownerId], references: [id])
  keyResult KeyResult?              @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  objective Objective?              @relation("SprintActivityObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  comments  SprintActivityComment[]
  tasks     SprintActivityTask[]

  @@index([sprintId, columnId, position])
  @@index([ownerId])
  @@map("sprint_activities")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
/// Trello-style comment thread on a sprint activity.
model SprintActivityComment {
  id         String   @id @default(cuid())
  activityId String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User?          @relation("SprintActivityCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([activityId, createdAt])
  @@map("sprint_activity_comments")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
/// Sub-task / checklist item on a sprint activity. Assignable to any user.
model SprintActivityTask {
  id          String    @id @default(cuid())
  activityId  String
  title       String
  status      String    @default("PENDING") // PENDING | COMPLETED
  assigneeId  String?
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignee User?          @relation("SprintActivityTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([activityId, position])
  @@map("sprint_activity_tasks")
}

/// Tracks last sent weekly digest per user (idempotency for the Monday job).
model EmailDigestState {
  userId            String    @id
  lastSentAt        DateTime?
  lastDigestCadence String? // "WEEKLY" — extensible
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_digest_state")
}

/// Outbound email queue — when SMTP isn't wired yet, every send lands here as a row
/// AND is mirrored to server logs. Once SMTP is configured, a worker can drain `status='PENDING'`.
model OutboundEmail {
  id        String    @id @default(cuid())
  toEmail   String
  toName    String?
  subject   String
  bodyText  String
  bodyHtml  String?
  template  String? // identifier of the template that produced this row
  metadata  String? // JSON context
  status    String    @default("PENDING") // PENDING | SENT | FAILED | LOGGED_ONLY
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("outbound_emails")
}

/// Risks flagged on an Objective or Key Result. Polymorphic — exactly one of
/// objectiveId / keyResultId is set. Severity + status are stored as String
/// to match the rest of the schema's enum-as-String convention.
model Risk {
  id          String  @id @default(cuid())
  title       String
  description String?
  severity    String // LOW | MEDIUM | HIGH | CRITICAL
  status      String  @default("OPEN") // OPEN | MITIGATING | RESOLVED | ACCEPTED
  mitigation  String?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResultId String?
  keyResult   KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("RiskReporter", fields: [reporterId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([objectiveId])
  @@index([keyResultId])
  @@index([status])
  @@map("risks")
}

/// AI-generated draft sprint plan. One row per Sprint that was produced by the AI planner.
/// See docs/AI_SPRINT_PLANNING.md for the full spec, allocations JSON shape, and acceptance criteria.
model AiSprintPlan {
  id               String    @id @default(cuid())
  /// One sprint may now have multiple plans — one per (subjectUserId) when a lead
  /// runs AI generation for several team members into the same team sprint.
  /// Uniqueness is enforced at app-level via the (sprintId, subjectUserId, status='DRAFT') idempotency check.
  sprintId         String
  subjectUserId    String?
  subjectDeptId    String?
  generatedById    String
  /// "anthropic" | "openai" | "gemini" — which provider produced this plan.
  provider         String    @default("anthropic")
  modelId          String
  promptTokens     Int       @default(0)
  outputTokens     Int       @default(0)
  cachedTokens     Int       @default(0)
  rationale        String
  /// Array<{ keyResultId, weightShare, timeBudgetPct, plannedDelta, carryoverDelta, velocityFactor, carryoverItemIds[] }>
  allocations      Json
  /// { completed, planned, blockers[], krDeltas[] } — null on first sprint.
  prevSprintReview Json?
  /// { total, kept, split, rescheduled, descoped, escalated, blockers[] }
  carryoverSummary Json?
  /// User instruction text supplied on regenerate. Null on initial draft.
  feedback         String?
  /// DRAFT | ACCEPTED | DISCARDED | SUPERSEDED
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId, status])
  @@index([subjectUserId, createdAt])
  @@index([status, createdAt])
  @@map("ai_sprint_plans")
}

/// Per-call audit row for every AI generation across the system. Used by the admin
/// observability surface (docs/AI_SPRINT_PLANNING.md §3.6) for cost rollups, cache-hit
/// telemetry, and error tracking.
model AiGenerationLog {
  id           String   @id @default(cuid())
  userId       String
  /// Free-form feature key — "SPRINT_PLAN" today; new AI surfaces add their own key.
  feature      String
  /// "anthropic" | "openai" | "gemini" — which provider was called.
  provider     String   @default("anthropic")
  modelId      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  /// Total estimated cost in USD for this single call.
  costUsd      Float    @default(0)
  /// End-to-end latency in milliseconds (request start → tool-use response parsed).
  latencyMs    Int?
  /// OK | ERROR
  status       String
  errorMessage String?
  /// Optional foreign key to AiSprintPlan when feature == SPRINT_PLAN. Loose pointer
  /// (no FK) so we can prune plans without losing the audit trail.
  planId       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@map("ai_generation_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Daily Trip Plan (DTP) — Travel & Mobility module.
// Spec: docs/Daily_Trip_Plan_Requirements_v1.0.md
// All status / mode / type fields are stored as String for portability — see
// types/dtp.ts for the canonical literal unions.
// ─────────────────────────────────────────────────────────────────────────────

/// Vehicle registry. Capacity is the max number of seated passengers
/// (driver excluded). `defaultDriverId` is the driver normally paired with
/// this vehicle — Pool Coordinator can override per day.
model Vehicle {
  id              String   @id @default(cuid())
  plate           String   @unique
  model           String?
  capacity        Int      @default(4)
  defaultDriverId String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  defaultDriver Driver?         @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id])
  drivers       Driver[]        @relation("DriverDefaultVehicle")
  runSheets     DailyRunSheet[]
  legs          TripLeg[]

  @@map("dtp_vehicles")
}

/// Driver registry. `userId` links to a `User` row when the driver also has a
/// platform account (so they can sign in to the run-sheet view); nullable for
/// external/contract drivers.
model Driver {
  id               String   @id @default(cuid())
  userId           String?  @unique
  fullName         String
  phone            String?
  license          String?
  photoUrl         String?
  defaultVehicleId String?
  isActive         Boolean  @default(true)
  workStart        String? // "08:30" (HH:MM); falls back to office working hours
  workEnd          String? // "17:30"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User?           @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  defaultVehicle    Vehicle?        @relation("DriverDefaultVehicle", fields: [defaultVehicleId], references: [id])
  vehiclesAsDefault Vehicle[]       @relation("VehicleDefaultDriver")
  runSheets         DailyRunSheet[]
  legs              TripLeg[]

  @@map("dtp_drivers")
}

/// Customizable trip-type (purpose) registry. Drives the icon, color, and
/// default dwell minutes pre-filled on a stop. Seeded with the spec's defaults.
model DtpTripType {
  id              String   @id @default(cuid())
  code            String   @unique // "MEETING", "BANK_VISIT", ...
  label           String
  icon            String? // lucide icon name
  color           String? // hex
  defaultDwellMin Int      @default(60)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops TripStop[]

  @@map("dtp_trip_types")
}

/// Per-department approval routing for DTP. `null` department = org-wide default.
/// `primaryCoordinatorId` and `alternateCoordinatorId` reference users.
model DtpDepartmentApproval {
  id                     String   @id @default(cuid())
  departmentId           String?  @unique // null = org default
  primaryCoordinatorId   String?
  alternateCoordinatorId String?
  failoverHours          Int      @default(4)
  managerEndorsementMode String   @default("OFF") // OFF | ADVISORY | REQUIRED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([departmentId])
  @@map("dtp_department_approvals")
}

/// Singleton-ish row keyed by id="default". Holds org-wide settings that aren't
/// per-department. Editable from /dashboard/settings/travel.
model DtpSettings {
  id                                  String   @id @default("default")
  // SLAs
  submissionCutoff                    String   @default("17:00") // HH:MM
  approvalSlaTime                     String   @default("08:30") // HH:MM same-day-of-trip
  // Working hours / geofence / defaults
  officeAnchorLat                     Float    @default(9.0192) // Addis Ababa fallback
  officeAnchorLng                     Float    @default(38.7525)
  officeLabel                         String   @default("Head Office")
  workStart                           String   @default("08:30")
  workEnd                             String   @default("17:30")
  sameAreaRadiusM                     Int      @default(800)
  defaultTripMode                     String   @default("ROUND_TRIP") // ROUND_TRIP | ONE_WAY
  // Traffic
  trafficAware                        Boolean  @default(true)
  trafficModel                        String   @default("best_guess") // best_guess | optimistic | pessimistic
  trafficBufferPct                    Int      @default(10)
  // Optimization
  optimizationEnabled                 Boolean  @default(true)
  optimizationMaxGroupSize            Int      @default(4)
  optimizationMaxDetourMin            Int      @default(15)
  optimizationMaxPassengersPerVehicle Int      @default(4)
  // Adjustment / acknowledgement
  adjustmentRequiresAcknowledgement   Boolean  @default(true)
  // Pool Coordinator user IDs (CSV) — comma-separated user.id list. Plain CSV
  // keeps schema portable (no Postgres array dep) and the list is small.
  poolCoordinatorIds                  String   @default("")
  // Operations Manager IDs (CSV) — read-all + override authority.
  operationsManagerIds                String   @default("")
  // Notification channels
  notifyEmail                         Boolean  @default(true)
  notifyInApp                         Boolean  @default(true)
  notifySms                           Boolean  @default(false)
  notifyTelegram                      Boolean  @default(false)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@map("dtp_settings")
}

/// One Daily Trip Plan per (requester, trip_date). Header for the day.
/// Stops live in `TripStop`; legs (driver-level work) in `TripLeg`.
model DailyTripPlan {
  id                      String    @id @default(cuid())
  requesterId             String
  departmentId            String? // resolved at submission time from primary membership
  tripDate                DateTime // calendar date (time component ignored)
  status                  String    @default("DRAFT")
  // Statuses: DRAFT | SUBMITTED | MANAGER_ENDORSED | UNDER_REVIEW | RETURNED |
  //           ADJUSTED | APPROVED | DRIVER_ASSIGNED | IN_PROGRESS | COMPLETED |
  //           RECONCILED | WITHDRAWN | CANCELLED | EXPIRED
  priority                String    @default("NORMAL") // NORMAL | URGENT
  defaultModeOfMovement   String    @default("COMPANY_VEHICLE") // WALKING|PUBLIC_TRANSPORT|COMPANY_VEHICLE|PERSONAL_VEHICLE|RIDE_HAIL|MIXED
  late                    Boolean   @default(false)
  emergency               Boolean   @default(false)
  emergencyReason         String?
  // Decision audit
  submittedAt             DateTime?
  decisionAt              DateTime?
  decisionById            String?
  decisionNote            String?
  managerEndorsedAt       DateTime?
  managerEndorsedById     String?
  acknowledgedAt          DateTime?
  // Aggregates (computed at decision; refreshed on relevant events)
  totalEstDurationMin     Int?
  totalEstDistanceKm      Float?
  totalEstTrafficDelayMin Int?
  estimatedCostEtb        Float?
  // Adjusted flag — set when Coordinator edited any stop before approving.
  adjusted                Boolean   @default(false)
  // Phase-2 reserved nullable hooks (UI hidden in Phase 1).
  linkedObjectiveId       String?
  linkedKeyResultId       String?
  linkedInitiativeId      String?
  // Soft-delete
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  requester User  @relation("DtpRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DtpDecidedBy", fields: [decisionById], references: [id], onDelete: SetNull)

  stops  TripStop[]
  legs   TripLeg[]
  events DtpEvent[]

  @@unique([requesterId, tripDate]) // one plan per employee per date
  @@index([tripDate, status])
  @@index([departmentId, tripDate])
  @@index([status])
  @@map("dtp_plans")
}

/// One stop within a plan. `seq` orders the day; `dwellMinutes` drives the
/// dwell-aware optimizer; `tripMode` is per-stop because mixed days are common.
model TripStop {
  id                     String   @id @default(cuid())
  planId                 String
  seq                    Int
  // Purpose
  tripTypeId             String?
  purposeCode            String // mirrors TripType.code at submission for stable history
  // Destination
  destinationName        String
  destinationAddress     String
  destinationLat         Float?
  destinationLng         Float?
  destinationPlaceId     String?
  contactPerson          String?
  contactPhone           String?
  // Timing
  plannedStart           String // HH:MM (24h, local time)
  dwellMinutes           Int      @default(60)
  flexibility            String   @default("FIXED") // FIXED | FLEX_30 | FLEX_2H | ANY_TIME
  // Mode
  tripMode               String   @default("ROUND_TRIP") // ROUND_TRIP | ONE_WAY
  modeOfMovement         String? // overrides plan default if set
  pickupBackTo           String? // OFFICE | NEXT_STOP | CUSTOM (only meaningful for ROUND_TRIP)
  pickupBackAddress      String? // when pickupBackTo = CUSTOM
  pickupBackLat          Float?
  pickupBackLng          Float?
  // Logistics
  requiresVehicle        Boolean  @default(true)
  requiresCashAdvance    Boolean  @default(false)
  cashAdvanceAmount      Float?
  reason                 String // free text — what the trip is for
  expectedOutcome        String?
  withWhom               String   @default("") // CSV of user.id joiners
  // Traffic snapshot — JSON: { baselineMin, withTrafficMin, departureTime, model }
  trafficEstimate        String?
  // Coordinator adjustment diff — JSON of {field: {before, after}}
  coordinatorAdjustments String?
  // Original snapshot before Coordinator edits (set on first edit, cleared on requester re-edit)
  originalSnapshot       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  plan     DailyTripPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tripType DtpTripType?  @relation(fields: [tripTypeId], references: [id], onDelete: SetNull)
  legs     TripLeg[]

  @@unique([planId, seq])
  @@index([planId])
  @@map("dtp_trip_stops")
}

/// Driver-level work unit generated from approved stops.
/// Two leg types: DROPOFF (always for vehicle-required stops) and RETURN_PICKUP
/// (only for ROUND_TRIP stops).
model TripLeg {
  id                  String    @id @default(cuid())
  planId              String
  tripStopId          String
  runSheetId          String?
  legType             String // DROPOFF | RETURN_PICKUP
  fromLabel           String
  fromLat             Float?
  fromLng             Float?
  toLabel             String
  toLat               Float?
  toLng               Float?
  scheduledTime       String // HH:MM
  estimatedTrafficMin Int?
  passengerIds        String    @default("") // CSV of user.id passengers
  vehicleId           String?
  driverId            String?
  status              String    @default("SCHEDULED") // SCHEDULED | EN_ROUTE | COMPLETED | SKIPPED
  actualTime          DateTime?
  actualLat           Float?
  actualLng           Float?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  plan     DailyTripPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tripStop TripStop       @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  runSheet DailyRunSheet? @relation(fields: [runSheetId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver   Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([runSheetId, scheduledTime])
  @@index([driverId, scheduledTime])
  @@index([tripStopId])
  @@map("dtp_trip_legs")
}

/// Daily Run Sheet — driver × date container. Created on driver assignment.
/// Legs reference this directly via runSheetId. Movement Sheets are derived
/// directly from plans + stops (no separate model needed).
model DailyRunSheet {
  id        String    @id @default(cuid())
  driverId  String
  vehicleId String?
  runDate   DateTime
  status    String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  driver  Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  legs    TripLeg[]

  @@unique([driverId, runDate])
  @@index([runDate])
  @@map("dtp_run_sheets")
}

/// Append-only audit trail for DTP. One row per state transition or material
/// edit. `payload` is JSON capturing the before/after diff for inspection.
model DtpEvent {
  id         String   @id @default(cuid())
  planId     String
  actorId    String?
  action     String // SUBMIT | ENDORSE | RETURN | ADJUST | APPROVE | REJECT | ACK | CANCEL | WITHDRAW | ASSIGN_DRIVER | LEG_STATUS | EDIT | CLONE
  fromStatus String?
  toStatus   String?
  payload    String? // JSON
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  plan  DailyTripPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actor User?         @relation("DtpEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([action, createdAt])
  @@map("dtp_events")
}

/// Carpool / co-location cluster suggestion produced by the optimizer. Phase-1
/// optimizer is a stub — schema is here so accepted/rejected suggestions are
/// auditable when the real optimizer ships.
model RouteGroup {
  id            String    @id @default(cuid())
  runDate       DateTime
  departmentId  String?
  tripStopIds   String // CSV of trip_stop.id members
  centerLat     Float?
  centerLng     Float?
  radiusM       Int?
  estSavingsKm  Float?
  estSavingsMin Int?
  estSavingsEtb Float?
  status        String    @default("SUGGESTED") // SUGGESTED | ACCEPTED | REJECTED
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([runDate])
  @@map("dtp_route_groups")
}
