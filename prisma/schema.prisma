// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production uses PostgreSQL (see env.example). `DATABASE_URL` is required.
  // Schema changes are applied via `prisma db push` from scripts/deploy.sh —
  // there is no migration history; `prisma/migrations/` is vestigial SQLite output.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums are represented as String for portability and simpler migrations

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  avatar    String?
  role      String   @default("EMPLOYEE") // ADMIN, EXECUTIVE, DEPARTMENT_LEAD, EMPLOYEE
  isActive  Boolean  @default(true)
  activationToken String?
  activationTokenExpires DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  ownedObjectives     Objective[]     @relation("ObjectiveOwner")
  ownedKeyResults     KeyResult[]     @relation("KeyResultOwner")
  assignedTodos       Todo[]          @relation("TodoAssignee")
  createdTodos        Todo[]          @relation("TodoCreator")
  keyResultCheckIns   KeyResultCheckIn[]
  comments            Comment[]
  notifications       Notification[]
  departmentMemberships DepartmentMembership[]
  managerRelationships ManagerRelationship[] @relation("Manager")
  directReports       ManagerRelationship[] @relation("DirectReport")
  clientErrorLogs     ClientErrorLog[]
  activityLogs        ActivityLog[]
  objectiveViews      ObjectiveView[]
  keyResultViews      KeyResultView[]
  objectiveContributions ObjectiveContributor[]
  ownedSprints        Sprint[]        @relation("SprintOwner")
  ownedSprintActivities SprintActivity[] @relation("SprintActivityOwner")
  sprintActivityComments SprintActivityComment[] @relation("SprintActivityCommentAuthor")
  assignedSprintActivityTasks SprintActivityTask[] @relation("SprintActivityTaskAssignee")
  emailDigestSent     EmailDigestState?
  initiativeUpdates   InitiativeUpdate[]  @relation("InitiativeUpdateAuthor")
  userPreferences     UserPreference?
  notificationPrefs   NotificationPreference[]
  watchers            Watcher[]
  favorites           Favorite[]
  todoMembers         TodoMember[]            @relation("TodoMemberUser")
  todoChecklistItems  TodoChecklistItem[]     @relation("TodoChecklistItemAssignee")
  todoAttachments     TodoAttachment[]        @relation("TodoAttachmentUploader")
  todoComments        TodoComment[]           @relation("TodoCommentAuthor")
  reportedRisks       Risk[]                  @relation("RiskReporter")
  sprintParticipations SprintParticipant[]    @relation("SprintParticipantUser")
  sprintsEnded         Sprint[]               @relation("SprintEndedBy")

  @@map("users")
}

/// User-starred OKRs surfaced under the "Watched" tab of the OKR Explorer.
/// Per-user, per-entity. Extend entityType to KEY_RESULT / TODO later.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // "OBJECTIVE" for now
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@map("favorites")
}

/// Stores per-user UI preferences (sidebar vs modal for todo view, etc).
model UserPreference {
  userId           String   @id
  todoViewMode     String   @default("modal") // "modal" | "sidebar"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberships DepartmentMembership[]
  objectives  Objective[]
  sprints     Sprint[]

  @@map("departments")
}

model DepartmentMembership {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  role         String?    // e.g., "Lead", "Member"
  joinedAt     DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("department_memberships")
}

model ManagerRelationship {
  id            String   @id @default(cuid())
  managerId     String
  directReportId String
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  manager      User @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)
  directReport User @relation("DirectReport", fields: [directReportId], references: [id], onDelete: Cascade)

  @@unique([managerId, directReportId])
  @@map("manager_relationships")
}

model Timeframe {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Q1 2025", "H2 2025", "January 2025"
  type        String   @default("QUARTERLY") // MONTHLY, QUARTERLY, SIX_MONTH, YEARLY
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectives Objective[]

  @@map("timeframes")
}

model Objective {
  id          String           @id @default(cuid())
  title       String
  description String?
  level       String           // COMPANY, DEPARTMENT, INDIVIDUAL
  status      String           @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  goalStatus  String           @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, CLOSED
  progress    Float            @default(0) // Calculated from Key Results
  // Owner-reported objective-level confidence (0-100). Read by Apple Pro hero/right-rail.
  // NOTE: requires `prisma db push` on deploy — preflight.sql already runs in CI.
  confidence  Int              @default(50)
  isPrivate   Boolean          @default(false) // Visibility: false = Public, true = Private
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  timeframeId String
  departmentId String?
  parentObjectiveId String?
  /// LOOSE = visual alignment only; STRICT_DEPENDENCY = progress can roll up from active child objectives
  alignmentType     String           @default("LOOSE")
  /// NONE | AVERAGE | SUM — used only when alignmentType is STRICT_DEPENDENCY and there are active children
  rollupCalculation String           @default("NONE")
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence    String           @default("WEEKLY")
  /// Raw weight used when this objective contributes to a parent's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  /// Otherwise, the relative weight among siblings determines contribution %.
  weight            Float            @default(0)
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  owner            User         @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  timeframe        Timeframe    @relation(fields: [timeframeId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  parentObjective  Objective?   @relation("ObjectiveHierarchy", fields: [parentObjectiveId], references: [id])
  childObjectives  Objective[]  @relation("ObjectiveHierarchy")
  keyResults       KeyResult[]
  comments         Comment[]
  objectiveLabels  ObjectiveLabel[]
  activityLogs     ActivityLog[]
  views            ObjectiveView[]
  sprintActivities SprintActivity[]  @relation("SprintActivityObjective")
  todos            Todo[]            @relation("TodoObjective")
  contributors     ObjectiveContributor[]
  risks            Risk[]

  @@map("objectives")
}

/// Additional people collaborating on an objective besides the sole owner.
/// Contributors can edit KRs and check in; they do NOT inherit admin rights.
model ObjectiveContributor {
  id          String    @id @default(cuid())
  objectiveId String
  userId      String
  addedAt     DateTime  @default(now())

  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId])
  @@index([userId])
  @@map("objective_contributors")
}

model KeyResult {
  id            String           @id @default(cuid())
  title         String
  description   String?
  startValue    Float            @default(0)
  targetValue   Float
  currentValue  Float            @default(0)
  unit          String           // e.g., "%", "users", "$"
  confidence    String           @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK
  progress      Float            @default(0) // Calculated from currentValue/targetValue
  status        String           @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  isPrivate     Boolean          @default(false) // Visibility: false = Public, true = Private
  ownerId       String
  objectiveId   String
  /// Mandatory check-in cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY
  checkInCadence String          @default("WEEKLY")
  /// Raw weight used when this KR contributes to its parent objective's progress.
  /// 0 = treated as auto (equal split with siblings whose weight is also 0).
  weight        Float            @default(0)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  owner   User    @relation("KeyResultOwner", fields: [ownerId], references: [id])
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  todos    Todo[] // Renamed conceptually to "Initiative" in the UI; table is `initiatives`
  comments Comment[]
  checkIns KeyResultCheckIn[]
  activityLogs ActivityLog[]
  views    KeyResultView[]
  sprintActivities SprintActivity[]
  risks    Risk[]

  @@map("key_results")
}

model KeyResultCheckIn {
  id          String   @id @default(cuid())
  keyResultId String
  asOfDate    DateTime
  value       Float
  /// Legacy enum-style tier kept for backward compatibility (ON_TRACK | AT_RISK | OFF_TRACK).
  /// New writes should also set `confidenceScore`; reads should prefer it.
  confidence  String
  /// Numeric 0-100 confidence captured from the Apple-style slider.
  /// Default 50 keeps existing rows valid until backfilled (see scripts/preflight.sql).
  confidenceScore Int @default(50)
  analysis    String?
  createdById String
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([keyResultId, asOfDate])
  @@map("key_result_check_ins")
}

/// Initiative / To-do — actionable work item.
/// Can be standalone (personal to-do), linked to a Key Result, or linked to an
/// Objective. The Prisma model name stays `Todo` so existing code paths keep
/// working; the underlying table is `initiatives` and user-facing labels say
/// "To-do" on the dedicated page and "Initiative" when shown under a KR.
model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String     @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  coverColor  String?    // hex or named colour for the card cover strip
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String
  creatorId   String
  /// Optional link to a Key Result — when set, the todo contributes toward KR work.
  keyResultId String?
  /// Optional link to an Objective — use when the work spans a whole objective
  /// rather than a single KR. Mutually informative with keyResultId; both can be set.
  objectiveId String?
  /// Numeric contribution in the parent KR's unit (ETB, pcs, qty, hours, %, …).
  /// When the initiative is marked COMPLETED, this value is summed into the
  /// parent KR's currentValue (see lib/objectiveProgress.ts → recalcKrFromInitiatives).
  progressValue Float?
  /// Sprint v2 (Phase 1) — optional link to a Sprint. Allows todos to participate in
  /// the unified Sprint+Todo board planned for Phase 3. SetNull on sprint delete.
  sprintId    String?
  /// Free-form task type tag (CALL, EMAIL, DEMO, MEETING, PROPOSAL, FOLLOW_UP, ADMIN, GENERAL).
  taskType    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  assignee    User        @relation("TodoAssignee", fields: [assigneeId], references: [id])
  creator     User        @relation("TodoCreator", fields: [creatorId], references: [id])
  keyResult   KeyResult?  @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  objective   Objective?  @relation("TodoObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  initiativeUpdates InitiativeUpdate[]
  members           TodoMember[]
  labels            TodoLabel[]
  checklists        TodoChecklist[]
  attachments       TodoAttachment[]
  todoComments      TodoComment[]
  activityLogs      ActivityLog[]

  @@index([assigneeId, status])
  @@index([creatorId, status])
  @@index([sprintId])
  @@index([taskType])
  @@index([sprintId, status])
  @@map("initiatives")
}

/// Additional members on a todo (beyond the single primary assignee).
model TodoMember {
  id        String   @id @default(cuid())
  todoId    String
  userId    String
  addedAt   DateTime @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation("TodoMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId])
  @@map("todo_members")
}

/// Coloured label attached to a todo. Label definitions live in TodoLabelDef.
model TodoLabel {
  id            String       @id @default(cuid())
  todoId        String
  labelDefId    String
  createdAt     DateTime     @default(now())

  todo     Todo         @relation(fields: [todoId], references: [id], onDelete: Cascade)
  labelDef TodoLabelDef @relation(fields: [labelDefId], references: [id], onDelete: Cascade)

  @@unique([todoId, labelDefId])
  @@map("todo_labels")
}

/// Board-wide label palette (name + color). Shared across all todos.
model TodoLabelDef {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366F1") // indigo default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoLabels TodoLabel[]

  @@map("todo_label_defs")
}

/// A named checklist group on a todo (a card can have multiple checklists).
model TodoChecklist {
  id        String   @id @default(cuid())
  todoId    String
  title     String   @default("Checklist")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo  Todo                @relation(fields: [todoId], references: [id], onDelete: Cascade)
  items TodoChecklistItem[]

  @@index([todoId, position])
  @@map("todo_checklists")
}

/// Individual item within a checklist.
model TodoChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completed   Boolean   @default(false)
  assigneeId  String?
  dueDate     DateTime?
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist TodoChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TodoChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@map("todo_checklist_items")
}

/// File attachment on a todo. Stores the file URL (uploaded to storage) + metadata.
model TodoAttachment {
  id           String   @id @default(cuid())
  todoId       String
  uploadedById String
  filename     String
  url          String   // storage URL (local path or CDN)
  mimeType     String
  size         Int      // bytes
  createdAt    DateTime @default(now())

  todo       Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TodoAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@map("todo_attachments")
}

/// WYSIWYG comment thread on a todo. Separate from InitiativeUpdate (daily updates).
model TodoComment {
  id        String   @id @default(cuid())
  todoId    String
  authorId  String
  content   String   // HTML from Tiptap
  parentId  String?  // for threaded replies
  /// JSON-encoded array of TodoAttachment ids that should render inline with this comment.
  /// Stored as a string (rather than relation) to avoid invasive M2M migration.
  commentAttachments String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo    Todo         @relation(fields: [todoId], references: [id], onDelete: Cascade)
  author  User         @relation("TodoCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  TodoComment? @relation("TodoCommentReplies", fields: [parentId], references: [id])
  replies TodoComment[] @relation("TodoCommentReplies")

  @@index([todoId, createdAt])
  @@map("todo_comments")
}

/// Mandatory daily update on an initiative. One row per (initiative, date).
/// The report page renders a day-by-day grid from these rows.
model InitiativeUpdate {
  id           String   @id @default(cuid())
  initiativeId String
  authorId     String
  updateDate   String   // YYYY-MM-DD bucket
  content      String
  status       String?  // optional status snapshot at time of update
  blockers     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiative Todo @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  author     User @relation("InitiativeUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, updateDate])
  @@index([updateDate])
  @@index([authorId, updateDate])
  @@map("initiative_updates")
}

/// Bi-weekly auto-calculated confidence snapshot for an objective or key result.
/// Stored once per entity per calculation period so the system keeps a history
/// of confidence transitions over time.
model ConfidenceSnapshot {
  id           String   @id @default(cuid())
  entityType   String   // OBJECTIVE | KEY_RESULT
  entityId     String
  periodStart  String   // YYYY-MM-DD (the first day of the bi-weekly period)
  confidence   String   // ON_TRACK | AT_RISK | OFF_TRACK
  score        Float    // 0-100 computed score
  factors      String?  // JSON: { progressPct, timeElapsedPct, velocity, ... }
  previousConf String?  // previous confidence for delta detection
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, periodStart])
  @@index([entityType, periodStart])
  @@map("confidence_snapshots")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorId    String
  objectiveId String?
  keyResultId String?
  parentId    String?  // For nested comments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  author     User       @relation(fields: [authorId], references: [id])
  objective  Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult  KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]  @relation("CommentReplies")

  @@map("comments")
}

/// In-app notification row. One row per (user, event) recipient.
/// `eventKey` is the canonical event code from lib/notifications/events.ts (e.g. "KR_AT_RISK").
/// `category` buckets multiple events for preference toggling (see NotificationPreference).
/// Email-related columns track the companion OutboundEmail send (if any).
model Notification {
  id         String    @id @default(cuid())
  type       String    // legacy OBJECTIVE_CREATED etc. — kept for backwards compat
  eventKey   String?   // canonical event code (e.g. "KR_AT_RISK")
  category   String?   // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  title      String
  message    String
  isRead     Boolean   @default(false)
  userId     String
  metadata   String?   // JSON: { objectiveId?, keyResultId?, todoId?, actorId?, entityTitle?, redacted? }
  /// When true, the recipient should NOT see the entity title/values — dispatcher already
  /// wrote placeholder text into `title`/`message`, but downstream deep-link rendering
  /// should continue to respect isPrivate on the linked entity.
  redacted   Boolean   @default(false)
  /// Companion email delivery fields (null if no email was intended for this row).
  emailMode  String?   // IMMEDIATE | DIGEST_DAILY | DIGEST_WEEKLY | DIGEST_MONTHLY | DISABLED
  emailSent  Boolean   @default(false)
  emailAt    DateTime?
  outboundEmailId String? // FK-ish pointer to OutboundEmail.id (no FK — OutboundEmail rows may be pruned)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([eventKey, createdAt])
  @@map("notifications")
}

/// Per-user notification preferences. One row per (user, category).
/// `inApp` / `email` toggle each channel. `emailCadence` controls batching for this category.
/// Missing rows fall back to the org defaults in OrgNotificationDefault.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  category     String   // ACCOUNT | OBJECTIVE | KEY_RESULT | CHECK_IN | TODO | TIMEFRAME | ALIGNMENT | COMMENT | ADMIN
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE") // IMMEDIATE | DAILY | WEEKLY | DISABLED
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// Org-level notification defaults set by Admin in Settings. Applied when the user has no
/// explicit NotificationPreference row for a category. One row per category.
model OrgNotificationDefault {
  id           String   @id @default(cuid())
  category     String   @unique
  inApp        Boolean  @default(true)
  email        Boolean  @default(true)
  emailCadence String   @default("IMMEDIATE")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("org_notification_defaults")
}

/// Opt-in watchers on an entity (objective, KR, or todo). Watchers receive dispatcher events
/// matching their subscription. Use the composite key to scope.
model Watcher {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // OBJECTIVE | KEY_RESULT | TODO
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("watchers")
}

/// Pending email digest entries. The dispatcher writes here when a user's preference for
/// a category is DAILY/WEEKLY/MONTHLY instead of IMMEDIATE. The digest cron drains these
/// rows into bundled OutboundEmail rows.
model EmailDigestQueue {
  id         String   @id @default(cuid())
  userId     String
  cadence    String   // DAILY | WEEKLY | MONTHLY
  category   String
  eventKey   String
  subject    String
  bodyText   String
  bodyHtml   String?
  metadata   String?  // JSON: { entityType, entityId, redacted, ... }
  queuedAt   DateTime @default(now())
  sentAt     DateTime?

  @@index([userId, cadence, sentAt])
  @@index([sentAt])
  @@map("email_digest_queue")
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Client-side crashes, unhandled rejections, and React error boundaries (troubleshooting).
model ClientErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  route     String?
  userAgent String?
  userId    String?
  digest    String?
  extra     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source])
  @@map("client_error_logs")
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3B82F6") // Default blue color
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  objectiveLabels ObjectiveLabel[]

  @@map("labels")
}

model ObjectiveLabel {
  id          String   @id @default(cuid())
  objectiveId String
  labelId     String
  createdAt   DateTime @default(now())

  // Relationships
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, labelId])
  @@map("objective_labels")
}

/// Activity log — append-only audit trail for objectives and key results.
/// One row per change. `action` is short ("CREATED", "UPDATED", "STATUS_CHANGED", "PROGRESS_UPDATED",
/// "ARCHIVED", "UNARCHIVED", "DELETED", "CHECKIN", "VIEWED", "COMMENTED", "INITIATIVE_ADDED", ...).
/// `changes` is a JSON string: `{ field: { from: any, to: any }, ... }`.
model ActivityLog {
  id           String   @id @default(cuid())
  entityType   String   // OBJECTIVE | KEY_RESULT | TODO | SPRINT
  objectiveId  String?
  keyResultId  String?
  todoId       String?
  /// Sprint v2 (Phase 1) — optional sprint association for sprint lifecycle events.
  sprintId     String?
  action       String
  actorId      String?
  /// JSONB on Postgres — `{ field: { from, to } }`. Was `String` (JSON-encoded) before
  /// the 2026-04-14 migration; existing rows were converted with `changes::jsonb`.
  changes      Json?
  /// JSONB on Postgres — extra context (e.g. ip, source page, snippet).
  metadata     Json?
  createdAt    DateTime @default(now())

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  todo      Todo?      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@index([keyResultId, createdAt])
  @@index([todoId, createdAt])
  @@index([sprintId, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

/// View tracking — capped to one row per (user, objective, day) by unique constraint
/// to keep storage bounded while still answering "who viewed and when".
model ObjectiveView {
  id          String   @id @default(cuid())
  objectiveId String
  userId      String
  viewDate    String   // YYYY-MM-DD bucket — enables one-row-per-day uniqueness
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId, viewDate])
  @@index([objectiveId, lastViewAt])
  @@map("objective_views")
}

model KeyResultView {
  id          String   @id @default(cuid())
  keyResultId String
  userId      String
  viewDate    String
  viewCount   Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, userId, viewDate])
  @@index([keyResultId, lastViewAt])
  @@map("key_result_views")
}

/// Sprint planning — Trello-style board for marketing/business teams.
/// Columns are dynamic per-sprint and become the activity status.
model Sprint {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED — legacy, kept for backward compat
  // Sprint v2 (Phase 1) — additive lifecycle/state model.
  state          String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, CANCELLED
  goal           String?
  goalLabel      String?
  goalTarget     Float?
  goalCurrent    Float?   @default(0)
  goalUnit       String?
  departmentId   String?
  reflectionNote String?
  endedAt        DateTime?
  endedById      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User             @relation("SprintOwner", fields: [ownerId], references: [id])
  columns    SprintColumn[]
  activities SprintActivity[]
  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  endedBy       User?               @relation("SprintEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  participants  SprintParticipant[]
  todos         Todo[]
  activityLogs  ActivityLog[]

  @@index([ownerId, status])
  @@index([state, endDate])
  @@index([departmentId])
  @@map("sprints")
}

/// Sprint v2 — explicit sprint membership. MEMBER for participants, OWNER mirrors creator.
model SprintParticipant {
  id        String   @id @default(cuid())
  sprintId  String
  userId    String
  role      String   @default("MEMBER") // MEMBER, OWNER
  joinedAt  DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation("SprintParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([userId])
  @@map("sprint_participants")
}

model SprintColumn {
  id        String   @id @default(cuid())
  sprintId  String
  name      String
  position  Int      @default(0)
  color     String?  // optional accent color for the column header
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprint     Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  activities SprintActivity[]

  @@unique([sprintId, name])
  @@index([sprintId, position])
  @@map("sprint_columns")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
model SprintActivity {
  id          String   @id @default(cuid())
  sprintId    String
  columnId    String
  title       String
  description String?
  ownerId     String
  /// Optional link to a Key Result — the activity contributes to this KR's work.
  keyResultId String?
  /// Optional link to an Objective (useful when the work spans a whole objective, not a single KR).
  objectiveId String?
  /// When set, points at the Initiative (Todo) row this activity was converted into.
  /// Lets the board show "converted" state and jump to the initiative record.
  convertedInitiativeId String?
  position    Int      @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprint    Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  column    SprintColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  owner     User          @relation("SprintActivityOwner", fields: [ownerId], references: [id])
  keyResult KeyResult?    @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  objective Objective?    @relation("SprintActivityObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  comments  SprintActivityComment[]
  tasks     SprintActivityTask[]

  @@index([sprintId, columnId, position])
  @@index([ownerId])
  @@map("sprint_activities")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
/// Trello-style comment thread on a sprint activity.
model SprintActivityComment {
  id         String   @id @default(cuid())
  activityId String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User?          @relation("SprintActivityCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([activityId, createdAt])
  @@map("sprint_activity_comments")
}

/// @deprecated Sprints v2 unified to Todo. Tables retained for rollback. Slated for removal after 2026-05-11. Do not add new fields here.
/// Sub-task / checklist item on a sprint activity. Assignable to any user.
model SprintActivityTask {
  id          String   @id @default(cuid())
  activityId  String
  title       String
  status      String   @default("PENDING") // PENDING | COMPLETED
  assigneeId  String?
  position    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity SprintActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignee User?          @relation("SprintActivityTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([activityId, position])
  @@map("sprint_activity_tasks")
}

/// Tracks last sent weekly digest per user (idempotency for the Monday job).
model EmailDigestState {
  userId            String   @id
  lastSentAt        DateTime?
  lastDigestCadence String?  // "WEEKLY" — extensible
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_digest_state")
}

/// Outbound email queue — when SMTP isn't wired yet, every send lands here as a row
/// AND is mirrored to server logs. Once SMTP is configured, a worker can drain `status='PENDING'`.
model OutboundEmail {
  id          String   @id @default(cuid())
  toEmail     String
  toName      String?
  subject     String
  bodyText    String
  bodyHtml    String?
  template    String?  // identifier of the template that produced this row
  metadata    String?  // JSON context
  status      String   @default("PENDING") // PENDING | SENT | FAILED | LOGGED_ONLY
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@map("outbound_emails")
}

/// Risks flagged on an Objective or Key Result. Polymorphic — exactly one of
/// objectiveId / keyResultId is set. Severity + status are stored as String
/// to match the rest of the schema's enum-as-String convention.
model Risk {
  id            String     @id @default(cuid())
  title         String
  description   String?
  severity      String     // LOW | MEDIUM | HIGH | CRITICAL
  status        String     @default("OPEN") // OPEN | MITIGATING | RESOLVED | ACCEPTED
  mitigation    String?

  objectiveId   String?
  objective     Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResultId   String?
  keyResult     KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  reporterId    String
  reporter      User       @relation("RiskReporter", fields: [reporterId], references: [id])

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  resolvedAt    DateTime?

  @@index([objectiveId])
  @@index([keyResultId])
  @@index([status])
  @@map("risks")
}
